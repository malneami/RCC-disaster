{
  "name": "@rcc/frontend",
  "version": "1.0.0",
  "description": "RCC Healthcare Platform Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite",
    "build": "tsc && NODE_OPTIONS='--max-old-space-size=4096' vite build",
