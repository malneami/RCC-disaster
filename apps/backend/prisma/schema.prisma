generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// enums.prisma
// Core enums for the application
enum UserRole {
  ADMIN
  RCC
  EMS
  DATA_COLLECTOR
  CATH_LAB_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum PatientGender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  UNKNOWN
}

enum PrivacyLevel {
  PUBLIC
  INTERNAL
  PRIVATE
  RESTRICTED
  CONFIDENTIAL
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_TRANSPORT
  COMPLETED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum TicketPathway {
  GENERAL
  STEMI
  STROKE
  TRAUMA
}

enum HospitalStatus {
  AVAILABLE
  LIMITED
  CRITICAL
  OFFLINE
  ACTIVE
}

enum TraumaLevel {
  NONE
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
}

enum CriticalCaseType {
  STEMI
  STROKE
  TRAUMA
}

enum CriticalCaseSeverity {
  CRITICAL
  URGENT
  STABLE
}

enum CriticalCaseStatus {
  ACTIVE
  RESOLVED
  TRANSFERRED
}

enum HospitalTicketType {
  TRANSFER
  CONSULTATION
  EMERGENCY
  MAINTENANCE
  SUPPLY
  OTHER
}

enum HospitalTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum MedicalRecordType {
  CONSULTATION
  LABORATORY
  RADIOLOGY
  SURGERY
  MEDICATION
  VACCINATION
  ALLERGY
  CHRONIC_CONDITION
  EMERGENCY_VISIT
  FOLLOW_UP
  REFERRAL
  DISCHARGE
  OTHER
}

enum AccessType {
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  SEARCH
}

enum ActivityType {
  USER_LOGIN
  USER_LOGOUT
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_ASSIGNED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ACCESSED
  PATIENT_EXPORTED
  HOSPITAL_UPDATED
  SYSTEM_ACCESS
  MEDICAL_RECORD_CREATED
  MEDICAL_RECORD_UPDATED
  DUPLICATE_DETECTED
  PRIVACY_BREACH
  STROKE_CASE_CREATED
  STROKE_CASE_UPDATED
  STROKE_TIMELINE_UPDATED
}

// Stroke-specific enums
enum StrokeType {
  ISCHEMIC
  HEMORRHAGIC
  TIA
  UNKNOWN
}

enum StrokeSeverity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum StrokeStatus {
  SUSPECTED
  CONFIRMED
  IMAGING_PENDING
  IMAGING_COMPLETE
  TREATMENT_EVALUATION
  THROMBOLYSIS_STARTED
  THROMBECTOMY_STARTED
  TREATMENT_COMPLETE
  STROKEUNIT_ADMITTED
  REHABILITATION_STARTED
  DISCHARGED
  FOLLOW_UP
}

enum StrokeTreatment {
  IV_THROMBOLYSIS
  MECHANICAL_THROMBECTOMY
  COMBINED_THERAPY
  CONSERVATIVE_MANAGEMENT
  SURGICAL_INTERVENTION
  NOT_ELIGIBLE
}

enum StrokeEventType {
  ARRIVAL
  TRIAGE
  ASSESSMENT
  IMAGING
  LABORATORY
  TREATMENT_START
  TREATMENT_COMPLETE
  TRANSFER
  DISCHARGE
  COMPLICATION
  FOLLOWUP
}


// user.prisma
// User model with comprehensive role management
model User {
  id                String      @id @default(uuid())
  email             String      @unique
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  phoneNumber       String?     @map("phone_number")
  role              UserRole
  status            UserStatus  @default(ACTIVE)
  isEmailVerified   Boolean     @default(false) @map("is_email_verified")
  passwordHash      String      @map("password_hash")
  lastLogin         DateTime?   @map("last_login")
  loginAttempts     Int         @default(0) @map("login_attempts")
  lockedUntil       DateTime?   @map("locked_until")
  passwordResetToken String?    @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")
  refreshToken      String?     @map("refresh_token")
  sessionExpiry     DateTime?   @map("session_expiry")
  hospitalId        String?     @map("hospital_id")
  
  // Audit Fields
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")
  
  // Relations
  hospital          Hospital?   @relation(fields: [hospitalId], references: [id])
  
  // Ticket Relations
  createdTickets    Ticket[]    @relation("TicketCreator")
  assignedTickets   Ticket[]    @relation("TicketAssignee")
  completedTickets  Ticket[]    @relation("TicketCompleter")
  
  // Patient Relations
  createdPatients   Patient[]   @relation("PatientCreator")
  accessedPatients  Patient[]   @relation("PatientAccessor")
  createdMedicalRecords MedicalRecord[] @relation("MedicalRecordCreator")
  patientAccessLogs PatientAccessLog[]
  
  // Hospital Relations
  createdCriticalCases CriticalCase[] @relation("CriticalCaseCreator")
  createdHospitalTickets HospitalTicket[] @relation("HospitalTicketCreator")
  assignedHospitalTickets HospitalTicket[] @relation("HospitalTicketAssignee")
  
  // Activity Relations
  activities        Activity[]
  
  // Stroke Relations
  createdStrokeCases StrokeCase[] @relation("StrokeCaseCreator")
  triggeredStrokeTimeline StrokeTimeline[] @relation("StrokeTimelineTriggeredBy")
  createdStrokeTimeline StrokeTimeline[] @relation("StrokeTimelineCreator")
  // createdStrokeAssessments StrokeAssessmentScore[] @relation("StrokeAssessmentCreator")
  // strokeRehabilitationTherapist StrokeRehabilitation[] @relation("StrokeRehabilitationTherapist")
  // createdStrokeRehabilitation StrokeRehabilitation[] @relation("StrokeRehabilitationCreator")
  
  @@map("users")
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([hospitalId])
}


// hospital.prisma
// Hospital model based on CSV data structure
model Hospital {
  id                String        @id @default(uuid())
  name              String
  address           String?
  latitude          Float?
  longitude         Float?
  
  // Bed Capacity - ICU
  icuBeds           Int           @default(0) @map("icu_beds")
  icuBedsAvailable  Int           @default(0) @map("icu_beds_available")
  
  // Bed Capacity - PICU
  picuBeds          Int           @default(0) @map("picu_beds")
  picuBedsAvailable Int           @default(0) @map("picu_beds_available")
  
  // Bed Capacity - Male/Female
  maleBeds          Int           @default(0) @map("male_beds")
  maleBedsAvailable Int           @default(0) @map("male_beds_available")
  femaleBeds        Int           @default(0) @map("female_beds")
  femaleBedsAvailable Int        @default(0) @map("female_beds_available")
  
  // Bed Capacity - Pediatric
  pediatricBeds     Int           @default(0) @map("pediatric_beds")
  pediatricBedsAvailable Int      @default(0) @map("pediatric_beds_available")
  
  // Bed Capacity - Standard
  standardBeds     Int           @default(0) @map("standard_beds")
  standardBedsAvailable Int      @default(0) @map("standard_beds_available")
  
  // Equipment
  ventilators       Int           @default(0)
  ventilatorsAvailable Int       @default(0) @map("ventilators_available")
  
  // Services
  hasStemiService   Boolean       @default(false) @map("has_stemi_service")
  hasStrokeService  Boolean       @default(false) @map("has_stroke_service")
  hasTraumaService  Boolean       @default(false) @map("has_trauma_service")
  
  // Hospital Info
  cluster           String        @default("Jazan")
  status            HospitalStatus @default(AVAILABLE)
  contactPhone      String?       @map("contact_phone")
  contactEmail      String?       @map("contact_email")
  
  // Update tokens
  updateToken       String?       @map("update_token")
  updateTokenExpiry DateTime?     @map("update_token_expiry")
  
  // Emergency Department
  emergencyDeptStatus String      @default("available") @map("emergency_dept_status")
  
  // NICU
  nicuBeds          Int           @default(0) @map("nicu_beds")
  nicuBedsAvailable Int           @default(0) @map("nicu_beds_available")
  
  // Specialized Services
  hasStrokeUnit     Boolean       @default(false) @map("has_stroke_unit")
  traumaLevel       TraumaLevel   @default(NONE) @map("trauma_level")
  hasCardiologyCenter Boolean     @default(false) @map("has_cardiology_center")
  
  // Stroke-specific capabilities
  strokeUnitBeds    Int           @default(0) @map("stroke_unit_beds")
  strokeUnitBedsAvailable Int     @default(0) @map("stroke_unit_beds_available")
  hasThrombolysis   Boolean       @default(false) @map("has_thrombolysis")
  hasThrombectomy   Boolean       @default(false) @map("has_thrombectomy")
  stroke24x7Service Boolean       @default(false) @map("stroke_24x7_service")
  avgDoorToImagingMinutes Int?    @map("avg_door_to_imaging_minutes")
  avgDoorToNeedleMinutes Int?     @map("avg_door_to_needle_minutes")
  avgDoorToGroinMinutes Int?      @map("avg_door_to_groin_minutes")
  lastStrokeCase    DateTime?     @map("last_stroke_case")
  strokeCasesPerMonth Int         @default(0) @map("stroke_cases_per_month")
  strokeCasesCurrentYear Int      @default(0) @map("stroke_cases_current_year")
  strokeSuccessRate Float?       @map("stroke_success_rate")
  strokeCertificationLevel String? @map("stroke_certification_level") // PRIMARY, COMPREHENSIVE, etc.
  
  // Audit fields
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  
  // Relations
  users             User[]
  originTickets     Ticket[]      @relation("OriginHospital")
  destinationTickets Ticket[]     @relation("DestinationHospital")
  criticalCases     CriticalCase[]
  hospitalTickets   HospitalTicket[]
  
  // Stroke Relations
  strokeOriginCases StrokeCase[]  @relation("StrokeOriginHospital")
  strokeDestinationCases StrokeCase[] @relation("StrokeDestinationHospital")
  // strokeKpiSummaries StrokeKpiSummary[]
  // strokeRehabilitationCenters StrokeRehabilitation[] @relation("StrokeRehabilitationCenter")
  
  @@map("hospitals")
  @@index([status])
  @@index([cluster])
  @@index([hasStemiService])
  @@index([hasStrokeService])
  @@index([hasTraumaService])
}


// patient.prisma
// Enhanced Patient model with comprehensive healthcare data management
model Patient {
  id              String         @id @default(uuid())
  
  // Basic Demographics
  mrn             String?        @unique @map("medical_record_number")
  nationalId      String?        @unique @map("national_id")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  middleName      String?        @map("middle_name")
  dateOfBirth     DateTime       @map("date_of_birth")
  gender          PatientGender
  maritalStatus   MaritalStatus? @map("marital_status")
  
  // Contact Information
  phoneNumber     String?        @map("phone_number")
  email           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?        @map("zip_code")
  country         String?        @default("Saudi Arabia")
  
  // Emergency Contacts
  emergencyContact String?       @map("emergency_contact")
  emergencyPhone  String?        @map("emergency_phone")
  emergencyEmail  String?        @map("emergency_email")
  emergencyRelationship String?  @map("emergency_relationship")
  
  // Insurance Information
  insuranceProvider String?      @map("insurance_provider")
  insuranceNumber   String?      @map("insurance_number")
  insuranceGroup    String?      @map("insurance_group")
  insuranceExpiry   DateTime?    @map("insurance_expiry")
  
  // Medical Information
  bloodType       String?        @map("blood_type")
  rhFactor        String?        @map("rh_factor")
  allergies       String?        // JSON string of allergies
  medications     String?        // JSON string of current medications
  medicalHistory  String?        @map("medical_history")
  riskFactors     String?        @map("risk_factors") // JSON string
  chronicConditions String?      @map("chronic_conditions") // JSON string
  
  // Physical Measurements
  weight          Float?         // in kg
  height          Float?         // in cm
  bmi             Float?         // Calculated BMI
  
  // HIPAA Compliance
  dataEncryptionKey String?      @map("data_encryption_key")
  privacyLevel    PrivacyLevel  @default(PRIVATE) @map("privacy_level")
  consentGiven    Boolean        @default(false) @map("consent_given")
  consentDate     DateTime?      @map("consent_date")
  dataRetentionPolicy String?    @map("data_retention_policy")
  
  // Duplicate Detection
  duplicateGroupId String?       @map("duplicate_group_id")
  isPrimaryRecord Boolean        @default(true) @map("is_primary_record")
  
  // Audit Fields
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  createdById     String         @map("created_by_id")
  lastAccessedAt  DateTime?      @map("last_accessed_at")
  lastAccessedBy  String?        @map("last_accessed_by")
  
  // Relations
  createdBy       User           @relation("PatientCreator", fields: [createdById], references: [id])
  lastAccessedByUser User?       @relation("PatientAccessor", fields: [lastAccessedBy], references: [id])
  tickets         Ticket[]
  medicalRecords  MedicalRecord[]
  accessLogs      PatientAccessLog[]
  
  // Stroke Relations
  strokeCases     StrokeCase[]
  // strokeAssessmentScores StrokeAssessmentScore[]
  // strokeRehabilitation StrokeRehabilitation[]
  
  @@map("patients")
  @@index([mrn])
  @@index([nationalId])
  @@index([lastName, firstName])
  @@index([dateOfBirth])
  @@index([duplicateGroupId])
  @@index([createdAt])
  @@index([lastAccessedAt])
}

// Medical Record model for detailed medical history
model MedicalRecord {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  recordType      MedicalRecordType @map("record_type")
  title           String
  description     String?
  diagnosis       String?
  treatment       String?
  medications     String?           // JSON string
  testResults     String?           // JSON string
  attachments     String?           // JSON string of file paths
  
  // Dates
  recordDate      DateTime          @map("record_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  createdById     String            @map("created_by_id")
  
  // Relations
  patient         Patient           @relation(fields: [patientId], references: [id])
  createdBy       User              @relation("MedicalRecordCreator", fields: [createdById], references: [id])
  
  @@map("medical_records")
  @@index([patientId])
  @@index([recordType])
  @@index([recordDate])
  @@index([createdAt])
}

// Patient Access Log for HIPAA compliance
model PatientAccessLog {
  id              String      @id @default(uuid())
  patientId       String      @map("patient_id")
  userId          String      @map("user_id")
  accessType       AccessType
  accessMethod     String      @map("access_method") // API, WEB, MOBILE
  ipAddress       String?     @map("ip_address")
  userAgent       String?     @map("user_agent")
  reason          String?     // Reason for access
  timestamp       DateTime    @default(now())
  
  // Relations
  patient         Patient     @relation(fields: [patientId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  
  @@map("patient_access_logs")
  @@index([patientId])
  @@index([userId])
  @@index([accessType])
  @@index([timestamp])
}


// ticket.prisma
// Enhanced Ticket model for comprehensive patient transfer management
model Ticket {
  id                  String          @id @default(uuid())
  ticketNumber        String          @unique @map("ticket_number")
  
  // Patient Information
  patientId           String          @map("patient_id")
  
  // Hospital Information
  originHospitalId    String          @map("origin_hospital_id")
  destinationHospitalId String?       @map("destination_hospital_id")
  
  // Ticket Classification
  priority            TicketPriority
  status              TicketStatus    @default(PENDING)
  pathway             TicketPathway  @default(GENERAL)
  
  // Medical Details
  chiefComplaint      String          @map("chief_complaint")
  symptoms            String?         // JSON string of symptoms
  vitals              String?         // JSON string of vital signs
  diagnostics         String?         // JSON string of diagnostic results
  treatmentPlan       String?         @map("treatment_plan")
  
  // Transport Details
  estimatedArrival    DateTime?       @map("estimated_arrival")
  actualArrival       DateTime?       @map("actual_arrival")
  transportMode       String?         @map("transport_mode")
  emsUnit             String?         @map("ems_unit")
  transportNotes      String?         @map("transport_notes")
  
  // Resource Requirements
  requiresBlood       Boolean         @default(false) @map("requires_blood")
  requiresSpecialist  Boolean         @default(false) @map("requires_specialist")
  requiresICU         Boolean         @default(false) @map("requires_icu")
  requiresVentilator  Boolean         @default(false) @map("requires_ventilator")
  requiredResources   String?         @map("required_resources") // JSON string
  
  // Emergency Information
  isEmergency         Boolean         @default(false) @map("is_emergency")
  emergencyType       String?         @map("emergency_type") // STEMI, STROKE, TRAUMA
  emergencySeverity   String?         @map("emergency_severity") // CRITICAL, URGENT, STABLE
  
  // Additional Information
  notes               String?
  internalNotes       String?         @map("internal_notes")
  externalNotes       String?         @map("external_notes")
  
  // Audit Fields
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  createdById         String          @map("created_by_id")
  assignedToId        String?         @map("assigned_to_id")
  completedById       String?         @map("completed_by_id")
  completedAt         DateTime?       @map("completed_at")
  
  // Relations
  patient             Patient         @relation(fields: [patientId], references: [id])
  originHospital      Hospital        @relation("OriginHospital", fields: [originHospitalId], references: [id])
  destinationHospital Hospital?       @relation("DestinationHospital", fields: [destinationHospitalId], references: [id])
  createdBy           User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo          User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  completedBy         User?           @relation("TicketCompleter", fields: [completedById], references: [id])
  activities          Activity[]
  
  // Stroke Relations
  strokeCases         StrokeCase[]
  strokeTimeline      StrokeTimeline[]
  
  @@map("tickets")
  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
  @@index([pathway])
  @@index([patientId])
  @@index([originHospitalId])
  @@index([destinationHospitalId])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([isEmergency])
}


// critical-case.prisma
// Critical Case model for tracking emergency cases
model CriticalCase {
  id              String              @id @default(uuid())
  patientName     String              @map("patient_name")
  caseType        CriticalCaseType    @map("case_type")
  severity        CriticalCaseSeverity
  status          CriticalCaseStatus  @default(ACTIVE)
  startTime       DateTime            @map("start_time")
  lastUpdate      DateTime            @updatedAt @map("last_update")
  description     String
  hospitalId      String              @map("hospital_id")
  createdById     String              @map("created_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  
  // Relations
  hospital        Hospital            @relation(fields: [hospitalId], references: [id])
  createdBy       User                @relation("CriticalCaseCreator", fields: [createdById], references: [id])
  
  @@map("critical_cases")
  @@index([hospitalId])
  @@index([caseType])
  @@index([severity])
  @@index([status])
  @@index([startTime])
}



// hospital-ticket.prisma
// Hospital Ticket model for managing hospital-related requests
model HospitalTicket {
  id              String                @id @default(uuid())
  title           String
  description     String
  type            HospitalTicketType
  priority        TicketPriority
  status          HospitalTicketStatus  @default(OPEN)
  hospitalId      String                @map("hospital_id")
  createdById     String                @map("created_by_id")
  assignedToId    String?               @map("assigned_to_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")
  
  // Relations
  hospital        Hospital              @relation(fields: [hospitalId], references: [id])
  createdBy       User                  @relation("HospitalTicketCreator", fields: [createdById], references: [id])
  assignedTo      User?                 @relation("HospitalTicketAssignee", fields: [assignedToId], references: [id])
  
  @@map("hospital_tickets")
  @@index([hospitalId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
}



// activity.prisma
// Activity model
model Activity {
  id          String      @id @default(uuid())
  type        ActivityType
  description String
  userId      String      @map("user_id")
  ticketId    String?     @map("ticket_id")
  metadata    String?     // JSON string for additional data
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  
  // Audit fields
  createdAt   DateTime    @default(now()) @map("created_at")
  
  // Relations
  user        User        @relation(fields: [userId], references: [id])
  ticket      Ticket?     @relation(fields: [ticketId], references: [id])
  
  @@map("activities")
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([ticketId])
}


// system.prisma
// System Configuration model
model SystemConfig {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  description String?
  isEncrypted Boolean   @default(false) @map("is_encrypted")
  
  // Audit fields
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@map("system_config")
}


// stroke-case.prisma
// Stroke Case model for comprehensive stroke care management
model StrokeCase {
  id                              String      @id @default(uuid())
  ticketId                        String      @map("ticket_id")
  patientId                       String      @map("patient_id")
  originHospitalId                String      @map("origin_hospital_id")
  destinationHospitalId           String?     @map("destination_hospital_id")
  
  // Stroke Classification
  strokeType                      StrokeType
  strokeSubtype                   String?     @map("stroke_subtype") // LARGE_VESSEL, SMALL_VESSEL, CARDIOEMBOLIC, etc.
  strokeSeverity                  StrokeSeverity?
  
  // Clinical Assessments
  nihssBaseline                   Int?        @map("nihss_baseline") // 0-42 scale
  nihss24hr                       Int?        @map("nihss_24hr")
  nihssDischarge                  Int?        @map("nihss_discharge")
  mrsBaseline                     Int?        @map("mrs_baseline") // 0-6 scale  
  mrs90day                        Int?        @map("mrs_90day")
  barthelBaseline                 Int?        @map("barthel_baseline") // 0-100 scale
  barthelDischarge                Int?        @map("barthel_discharge")
  aspectsScore                    Int?        @map("aspects_score") // 0-10 scale
  gcsBaseline                     Int?        @map("gcs_baseline") // 3-15 scale
  
  // Symptom & Presentation
  presentingSymptoms              String?     @map("presenting_symptoms")
  symptomOnset                    DateTime?   @map("symptom_onset")
  symptomToHospitalMinutes        Int?        @map("symptom_to_hospital_minutes")
  lastKnownWell                   DateTime?   @map("last_known_well")
  wakeUpStroke                    Boolean     @default(false) @map("wake_up_stroke")
  
  // Treatment Details  
  currentStatus                   StrokeStatus @map("current_status")
  selectedTreatment               StrokeTreatment? @map("selected_treatment")
  eligibleForThrombolysis         Boolean?    @map("eligible_for_thrombolysis")
  thrombolysisContraindications   String?     @map("thrombolysis_contraindications")
  eligibleForThrombectomy         Boolean?    @map("eligible_for_thrombectomy")
  thrombectomyContraindications   String?     @map("thrombectomy_contraindications")
  
  // Pathway Timings
  pathwayStarted                  DateTime?   @map("pathway_started")
  pathwayCompleted                DateTime?   @map("pathway_completed")
  strokeUnitAdmissionTime         DateTime?   @map("stroke_unit_admission_time")
  
  // Key Performance Timings (minutes)
  doorToImagingMinutes            Int?        @map("door_to_imaging_minutes")
  doorToNeedleMinutes             Int?        @map("door_to_needle_minutes") // For thrombolysis
  doorToGroinMinutes              Int?        @map("door_to_groin_minutes") // For thrombectomy  
  symptomNeedleMinutes            Int?        @map("symptom_needle_minutes")
  symptomGroinMinutes             Int?        @map("symptom_groin_minutes")
  imagingToNeedleMinutes          Int?        @map("imaging_to_needle_minutes")
  imagingToGroinMinutes           Int?        @map("imaging_to_groin_minutes")
  
  // Clinical Assessments Timeline  
  dysphagiaScreeningMinutes       Int?        @map("dysphagia_screening_minutes") // From admission
  earlyMobilizationHours          Int?        @map("early_mobilization_hours") // From admission
  speechTherapyHours              Int?        @map("speech_therapy_hours")
  physiotherapyHours              Int?        @map("physiotherapy_hours")
  occupationalTherapyHours        Int?        @map("occupational_therapy_hours")
  
  // Imaging Results
  ctResults                       String?     @map("ct_results")
  ctaResults                      String?     @map("cta_results")
  ctpResults                      String?     @map("ctp_results")
  mriResults                      String?     @map("mri_results")
  mraResults                      String?     @map("mra_results")
  echocardiogram                  String?
  carotidUcsDoppler               String?     @map("carotid_ucs_doppler")
  
  // Treatment Outcomes
  successful                      Boolean?
  recanalizationGrade             String?     @map("recanalization_grade") // mTICI 0, 1, 2a, 2b, 3
  complications                   String?
  secondaryPrevention             String?     @map("secondary_prevention")
  
  // Discharge & Follow-up
  dischargeDestination            String?     @map("discharge_destination") // HOME, REHABILITATION, NURSING_HOME, etc.
  dischargeDate                   DateTime?   @map("discharge_date")
  lengthOfStayDays                Int?        @map("length_of_stay_days")
  thirtyDayReadmission            Boolean?    @map("thirty_day_readmission")
  ninetyDayMortality              Boolean?    @map("ninety_day_mortality")
  followUpCallCompleted           Boolean?    @map("follow_up_call_completed")
  followUpCallDate                DateTime?   @map("follow_up_call_date")
  
  // KPI Tracking
  metKpi1                         Boolean?    @map("met_kpi1") // Door to imaging ≤25min
  metKpi2                         Boolean?    @map("met_kpi2") // Door to needle ≤60min  
  metKpi3                         Boolean?    @map("met_kpi3") // Door to groin ≤90min
  metKpi4                         Boolean?    @map("met_kpi4") // Stroke unit admission ≤4hr
  metKpi5                         Boolean?    @map("met_kpi5") // Dysphagia screening ≤4hr
  metKpi6                         Boolean?    @map("met_kpi6") // Early mobilization ≤24hr
  metKpi7                         Boolean?    @map("met_kpi7") // Secondary prevention prescribed
  metKpi8                         Boolean?    @map("met_kpi8") // Appropriate rehabilitation referral
  
  // Audit Fields
  createdAt                       DateTime    @default(now()) @map("created_at")
  updatedAt                       DateTime    @updatedAt @map("updated_at")
  deletedAt                       DateTime?   @map("deleted_at")
  createdById                     String      @map("created_by_id")
  
  // Relations
  ticket                          Ticket      @relation(fields: [ticketId], references: [id])
  patient                         Patient     @relation(fields: [patientId], references: [id])
  originHospital                  Hospital    @relation("StrokeOriginHospital", fields: [originHospitalId], references: [id])
  destinationHospital             Hospital?   @relation("StrokeDestinationHospital", fields: [destinationHospitalId], references: [id])
  createdBy                       User        @relation("StrokeCaseCreator", fields: [createdById], references: [id])
  
  // Related Models
  timeline                        StrokeTimeline[]
  // assessmentScores                StrokeAssessmentScore[]
  // rehabilitation                  StrokeRehabilitation[]
  
  @@map("stroke_cases")
  @@index([ticketId])
  @@index([patientId])
  @@index([originHospitalId])
  @@index([destinationHospitalId])
  @@index([strokeType])
  @@index([strokeSeverity])
  @@index([currentStatus])
  @@index([createdAt])
  @@index([createdById])
}


// stroke-timeline.prisma
// Stroke Timeline model for tracking stroke care events
model StrokeTimeline {
  id                      String          @id @default(uuid())
  strokeCaseId            String          @map("stroke_case_id")
  ticketId                String          @map("ticket_id")
  
  // Status Tracking
  fromStatus              StrokeStatus?   @map("from_status")
  toStatus                StrokeStatus    @map("to_status")
  
  // Event Details
  eventTimestamp          DateTime        @map("event_timestamp")
  eventDescription        String          @map("event_description")
  eventLocation           String?         @map("event_location") // ED, CT_SUITE, ANGIO_SUITE, STROKE_UNIT
  eventType               StrokeEventType @map("event_type")
  triggeredBy             String          @map("triggered_by")
  
  // Timing Metrics
  minutesFromSymptom      Int?            @map("minutes_from_symptom")
  minutesFromAdmission    Int?            @map("minutes_from_admission")
  withinTarget            Boolean?        @map("within_target")
  targetMinutes           Int?            @map("target_minutes")
  
  // Clinical Context
  nihssAtSession          Int?            @map("nihss_at_session")
  clinicalNotes           String?         @map("clinical_notes")
  
  // Audit Fields
  createdAt               DateTime        @default(now()) @map("created_at")
  createdById             String          @map("created_by_id")
  
  // Relations
  strokeCase              StrokeCase      @relation(fields: [strokeCaseId], references: [id])
  ticket                  Ticket          @relation(fields: [ticketId], references: [id])
  triggeredByUser         User            @relation("StrokeTimelineTriggeredBy", fields: [triggeredBy], references: [id])
  createdBy               User            @relation("StrokeTimelineCreator", fields: [createdById], references: [id])
  
  @@map("stroke_timeline")
  @@index([strokeCaseId])
  @@index([ticketId])
  @@index([eventTimestamp])
  @@index([eventType])
  @@index([toStatus])
  @@index([createdAt])
}

