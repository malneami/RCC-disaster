  error        String?
  timestamp    DateTime @default(now())
  
  @@map("gps_api_logs")
  @@index([vehicleId])
  @@index([timestamp])
  @@index([endpoint])
}

// GPS Validation Log model for tracking validation failures (minimal logging)
model GPSValidationLog {
  id              String   @id @default(uuid())
  vehicleId       String   @map("vehicle_id")
  isValid         Boolean  @map("is_valid")
  error           String?
  validationRules String   @map("validation_rules") // JSON string
  timestamp       DateTime @default(now())
  
  @@map("gps_validation_logs")
  @@index([vehicleId])
  @@index([timestamp])
  @@index([isValid])
}




