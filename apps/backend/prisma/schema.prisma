// user.prisma
// User model with comprehensive role management
model User {
  id                String      @id @default(uuid())
  email             String?     @unique
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  phoneNumber       String?     @map("phone_number")
  role              UserRole
  status            UserStatus  @default(ACTIVE)
  isEmailVerified   Boolean     @default(false) @map("is_email_verified")
  passwordHash      String      @map("password_hash")
  lastLogin         DateTime?   @map("last_login")
  loginAttempts     Int         @default(0) @map("login_attempts")
  lockedUntil       DateTime?   @map("locked_until")
  passwordResetToken String?    @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")
  refreshToken      String?     @map("refresh_token")
  sessionExpiry     DateTime?   @map("session_expiry")
  hospitalId        String?     @map("hospital_id")
  
  // Audit Fields
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")
  
  // Relations
  hospital          Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  // Ticket Relations
  createdTickets    Ticket[]    @relation("TicketCreator")
  assignedTickets   Ticket[]    @relation("TicketAssignee")
  completedTickets  Ticket[]    @relation("TicketCompleter")
  emsStatusUpdatedTickets Ticket[] @relation("TicketEMSStatusUpdater")
  acknowledgedTickets Ticket[]  @relation("TicketAcknowledger")
  accessedTickets   Ticket[]    @relation("TicketAccessor")
  
  // Patient Relations
  createdPatients   Patient[]   @relation("PatientCreator")
  accessedPatients  Patient[]   @relation("PatientAccessor")
  createdMedicalRecords MedicalRecord[] @relation("MedicalRecordCreator")
  accessedMedicalRecords MedicalRecord[] @relation("MedicalRecordAccessor")
  patientAccessLogs PatientAccessLog[]
  ticketAccessLogs  TicketAccessLog[]
  medicalRecordAccessLogs MedicalRecordAccessLog[]
  
  // Hospital Relations
  createdCriticalCases CriticalCase[] @relation("CriticalCaseCreator")
  createdHospitalTickets HospitalTicket[] @relation("HospitalTicketCreator")
  assignedHospitalTickets HospitalTicket[] @relation("HospitalTicketAssignee")
  
  // Activity Relations
  activities        Activity[]
  
  // Stroke Relations
  createdStrokeCases StrokeCase[] @relation("StrokeCaseCreator")
  triggeredStrokeTimeline StrokeTimeline[] @relation("StrokeTimelineTriggeredBy")
  createdStrokeTimeline StrokeTimeline[] @relation("StrokeTimelineCreator")
  createdStrokeAssessments StrokeAssessmentScore[] @relation("StrokeAssessmentCreator")
  strokeRehabilitationTherapist StrokeRehabilitation[] @relation("StrokeRehabilitationTherapist")
  createdStrokeRehabilitation StrokeRehabilitation[] @relation("StrokeRehabilitationCreator")
  
  // STEMI Relations
  createdStemiCases StemiCase[] @relation("StemiCaseCreator")
  
  // Trauma Relations
  createdTraumaCases TraumaCase[] @relation("TraumaCaseCreator")

  // OB Maternal Relations
  createdObMaternalTransfers ObMaternalTransfer[] @relation("ObMaternalTransferCreator")

  // Neurosurgical Relations
  createdNeurosurgicalCases NeurosurgicalCase[] @relation("NeurosurgicalCaseCreator")
  closedNeurosurgicalCases NeurosurgicalCase[] @relation("NeurosurgicalCaseCloser")
  
  // EMS Relations
  ambulanceDriver     Ambulance?         @relation("AmbulanceDriver")
  driverSchedules     DriverSchedule[]   @relation("DriverScheduleDriver")
  emsAssignmentDriver EMSAssignment[]    @relation("EMSAssignmentDriver")
  createdEMSAssignments EMSAssignment[]  @relation("EMSAssignmentCreator")
  emsAlertDriver      EMSAlert[]         @relation("EMSAlertDriver")
  acknowledgedEMSAlerts EMSAlert[]       @relation("EMSAlertAcknowledgedBy")
  createdMaintenanceRecords MaintenanceRecord[] @relation("MaintenanceRecordCreator")
  timelineEventDriver TimelineEvent[]    @relation("TimelineEventDriver")
  triggeredTimelineEvents TimelineEvent[] @relation("TimelineEventTriggeredBy")
  createdTimelineEvents TimelineEvent[]  @relation("TimelineEventCreator")
  
  // Notification Relations
  createdNotifications Notification[]    @relation("NotificationCreator")
  readNotifications    Notification[]    @relation("NotificationReader")
  notificationRecipients NotificationRecipient[] @relation("NotificationRecipientUser")
  createdCaseNotes      CaseNote[]       @relation("CaseNoteCreator")
  caseNoteRecipients    CaseNoteRecipient[] @relation("CaseNoteRecipientUser")
  createdReplies        Reply[]          @relation("ReplyCreator")
  
  // Registration Request Relations
  reviewedRegistrationRequests UserRegistrationRequest[] @relation("RegistrationRequestReviewer")
  
  // Bed Management Relations
  bedRequestRequester BedRequest[] @relation("BedRequestRequester")
  bedRequestApprover BedRequest[] @relation("BedRequestApprover")
  bedRequestAssigner BedRequest[] @relation("BedRequestAssigner")
  bedStatusChanger BedStatusHistory[] @relation("BedStatusChanger")
  
  // Support Ticket Relations
  createdSupportTickets SupportTicket[] @relation("SupportTicketCreator")
  resolvedSupportTickets SupportTicket[] @relation("SupportTicketResolver")
  supportMessages SupportMessage[] @relation("SupportMessageSender")
  uploadedSupportAttachments SupportAttachment[] @relation("SupportAttachmentUploader")
  uploadedMedicalRecordAttachments MedicalRecordAttachment[] @relation("MedicalRecordAttachmentUploader")
  
  // Recording Relations
  recordingsAsCaller     Recording[]                  @relation("RecordingCaller")
  recordingsAsCallee     Recording[]                  @relation("RecordingCallee")
  recordingParticipants  RecordingParticipant[]       @relation("RecordingParticipants")
  transcriptSegments     RecordingTranscriptSegment[] @relation("SegmentSpeaker")

  // Disaster Relations
  createdDisasterIncidents     DisasterIncident[]         @relation("DisasterIncidentCreator")
  resolvedDisasterIncidents    DisasterIncident[]         @relation("DisasterIncidentResolver")
  disasterAmbulanceAssignments DisasterAmbulanceAssignment[] @relation("DisasterAmbulanceAssignor")
  createdDisasterAnnouncements DisasterAnnouncement[]     @relation("DisasterAnnouncementCreator")
  approvedDisasterAnnouncements DisasterAnnouncement[]    @relation("DisasterAnnouncementApprover")
  disasterAuditLogs            DisasterAuditLog[]
  createdDisasterNotifications DisasterNotification[]     @relation("DisasterNotificationCreator")
  disasterNotificationRecipients DisasterNotificationRecipient[] @relation("DisasterNotificationRecipientUser")
  createdDisasterMessages      DisasterMessage[]          @relation("DisasterMessageCreator")

  // Command Room Relations
  activatedCommandRooms        DisasterCommandRoom[]      @relation("DisasterCommandRoomActivator")
  closedCommandRooms           DisasterCommandRoom[]      @relation("DisasterCommandRoomCloser")
  disasterCommandRoleAssignments DisasterCommandRoleAssignment[] @relation("DisasterCommandRoleUser")
  disasterCommandRoleAssignor  DisasterCommandRoleAssignment[] @relation("DisasterCommandRoleAssignor")
  disasterCommandDecisionLogs  DisasterCommandDecisionLog[] @relation("DisasterCommandDecisionUser")

  // MCP Audit Relations
  createdAuditEvents           AuditEvent[]                 @relation("AuditEventCreator")
  generatedAuditReports        AuditReport[]                @relation("AuditReportGenerator")

  @@map("users")
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([hospitalId])
}

// User registration request model for pending approvals
model UserRegistrationRequest {
  id                String      @id @default(uuid())
  email             String      @unique
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  phoneNumber       String?     @map("phone_number")
  passwordHash      String      @map("password_hash")
  requestedRole     UserRole    @map("requested_role")
  hospitalId        String?     @map("hospital_id")
  justification     String?     // Why they need access
  status            RegistrationRequestStatus @default(PENDING)
  
  // Admin approval fields
  reviewedBy        String?     @map("reviewed_by")
  reviewedAt        DateTime?   @map("reviewed_at")
  adminComments     String?     @map("admin_comments")
  
  // Audit Fields
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  
  // Relations
  hospital          Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  reviewer          User?       @relation("RegistrationRequestReviewer", fields: [reviewedBy], references: [id])
  
  @@map("user_registration_requests")
  @@index([email])
  @@index([requestedRole])
  @@index([status])
  @@index([hospitalId])
  @@index([reviewedBy])
}


// hospital.prisma
// Hospital model based on CSV data structure
model Hospital {
  id                String        @id @default(uuid())
  name              String
  address           String?
  latitude          Float?
  longitude         Float?
  
  // Bed Capacity - ICU
  // @deprecated Use Bed model with BedType.ICU instead. This field is kept for backward compatibility.
  // Aggregated counts should be computed from Bed records via service layer.
  icuBeds           Int           @default(0) @map("icu_beds")
  icuBedsAvailable  Int           @default(0) @map("icu_beds_available")
  
  // Bed Capacity - PICU
  // @deprecated Use Bed model with BedType.PICU instead. This field is kept for backward compatibility.
  picuBeds          Int           @default(0) @map("picu_beds")
  picuBedsAvailable Int           @default(0) @map("picu_beds_available")
  
  // Bed Capacity - Male/Female
  // @deprecated Use Bed model with BedType.MALE_WARD instead. This field is kept for backward compatibility.
  maleBeds          Int           @default(0) @map("male_beds")
  maleBedsAvailable Int           @default(0) @map("male_beds_available")
  // @deprecated Use Bed model with BedType.FEMALE_WARD instead. This field is kept for backward compatibility.
  femaleBeds        Int           @default(0) @map("female_beds")
  femaleBedsAvailable Int        @default(0) @map("female_beds_available")
  
  // Bed Capacity - Pediatric
  // @deprecated Use Bed model with BedType.PEDIATRIC_WARD instead. This field is kept for backward compatibility.
  pediatricBeds     Int           @default(0) @map("pediatric_beds")
  pediatricBedsAvailable Int      @default(0) @map("pediatric_beds_available")
  
  // Bed Capacity - Standard
  // @deprecated Use Bed model with BedType.STANDARD_WARD instead. This field is kept for backward compatibility.
  standardBeds     Int           @default(0) @map("standard_beds")
  standardBedsAvailable Int      @default(0) @map("standard_beds_available")
  
  // Services
  hasStemiService   Boolean       @default(false) @map("has_stemi_service")
  hasStrokeService  Boolean       @default(false) @map("has_stroke_service")
  hasTraumaService  Boolean       @default(false) @map("has_trauma_service")
  hasNeurosurgeryService Boolean  @default(false) @map("has_neurosurgery_service")
  
  // Hospital Info
  cluster           String        @default("Jazan")
  status            HospitalStatus @default(AVAILABLE)
  contactPhone      String?       @map("contact_phone")
  contactEmail      String?       @map("contact_email")
  
  // Update tokens
  updateToken       String?       @map("update_token")
  updateTokenExpiry DateTime?     @map("update_token_expiry")
  
  // Emergency Department
  emergencyDeptStatus String      @default("available") @map("emergency_dept_status")
  
  // NICU
  // @deprecated Use Bed model with BedType.NICU instead. This field is kept for backward compatibility.
  nicuBeds          Int           @default(0) @map("nicu_beds")
  nicuBedsAvailable Int           @default(0) @map("nicu_beds_available")
  
  // Specialized Services
  hasStrokeUnit     Boolean       @default(false) @map("has_stroke_unit")
  traumaLevel       TraumaLevel   @default(NONE) @map("trauma_level")
  hasCardiologyCenter Boolean     @default(false) @map("has_cardiology_center")
  
  // Stroke-specific capabilities
  // @deprecated Use Bed model with BedType.STROKE_UNIT instead. This field is kept for backward compatibility.
  strokeUnitBeds    Int           @default(0) @map("stroke_unit_beds")
  strokeUnitBedsAvailable Int     @default(0) @map("stroke_unit_beds_available")
  hasThrombolysis   Boolean       @default(false) @map("has_thrombolysis")
  hasThrombectomy   Boolean       @default(false) @map("has_thrombectomy")
  stroke24x7Service Boolean       @default(false) @map("stroke_24x7_service")
  avgDoorToCtScanMinutes Int?    @map("avg_door_to_ct_scan_minutes")
  avgDoorToNeedleMinutes Int?     @map("avg_door_to_needle_minutes")
  avgDoorToMechanicalThrombectomyMinutes Int? @map("avg_door_to_mechanical_thrombectomy_minutes")
  lastStrokeCase    DateTime?     @map("last_stroke_case")
  strokeCasesPerMonth Int         @default(0) @map("stroke_cases_per_month")
  strokeCasesCurrentYear Int      @default(0) @map("stroke_cases_current_year")
  strokeSuccessRate Float?       @map("stroke_success_rate")
  strokeCertificationLevel String? @map("stroke_certification_level") // PRIMARY, COMPREHENSIVE, etc.
  
  // Audit fields
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  
  // Relations
  users             User[]
  originTickets     Ticket[]      @relation("OriginHospital")
  destinationTickets Ticket[]     @relation("DestinationHospital")
  criticalCases     CriticalCase[]
  hospitalTickets   HospitalTicket[]
  
  // Stroke Relations
  strokeOriginCases StrokeCase[]  @relation("StrokeOriginHospital")
  strokeDestinationCases StrokeCase[] @relation("StrokeDestinationHospital")
  strokeKpiSummaries StrokeKpiSummary[]
  strokeRehabilitationCenters StrokeRehabilitation[] @relation("StrokeRehabilitationCenter")
  
  // STEMI Relations
  stemiOriginCases StemiCase[]  @relation("StemiOriginHospital")
  stemiDestinationCases StemiCase[] @relation("StemiDestinationHospital")
  
  // Trauma Relations
  traumaOriginCases TraumaCase[]  @relation("TraumaOriginHospital")
  traumaDestinationCases TraumaCase[] @relation("TraumaDestinationHospital")
  
  // User Registration Relations
  userRegistrationRequests UserRegistrationRequest[]
  
  // Ambulance Relations
  zoneLogs                 AmbulanceZoneLog[]
  
  // Bed Management Relations
  units                    Unit[]
  beds                     Bed[]
  bedRequests              BedRequest[]

  // Disaster Relations
  disasterAnnouncementLogs DisasterAnnouncementHospitalLog[]
  disasterDestinationAssignments DisasterAmbulanceAssignment[] @relation("DisasterDestinationHospital")

  // OB Maternal Relations
  obMaternalReferring   ObMaternalTransfer[] @relation("ObReferringHospital")
  obMaternalDestination ObMaternalTransfer[] @relation("ObDestinationHospital")

  // Neurosurgical Relations
  neurosurgicalOriginCases NeurosurgicalCase[] @relation("NeurosurgicalOriginHospital")
  neurosurgicalDestinationCases NeurosurgicalCase[] @relation("NeurosurgicalDestinationHospital")

  @@map("hospitals")
  @@index([status])
  @@index([cluster])
  @@index([hasStemiService])
  @@index([hasStrokeService])
  @@index([hasTraumaService])
