// ems-assignment.prisma
// EMS Assignment model for managing ambulance and driver assignments
model EMSAssignment {
  id                      String          @id @default(uuid())
  
  // Assignment Details
  ticketId                String          @map("ticket_id")
  ambulanceId             String?         @map("ambulance_id")
  driverId                String?         @map("driver_id")
  
  // Timing Information
  assignedAt              DateTime        @map("assigned_at")
  status                  AssignmentStatus @default(EMS_CONTACT)
  emsContactTime          DateTime?       @map("ems_contact_time")
  actualArrivalTime       DateTime?       @map("actual_arrival_time")
  journeyStartTime        DateTime?       @map("journey_start_time")
  journeyEndTime          DateTime?       @map("journey_end_time")
  
  // Journey Details
  distanceKm              Float?          @map("distance_km")
  notes                   String?

  // ETA Information
  estimatedArrivalMinutes  Int?      @map("estimated_arrival_minutes")
  estimatedArrivalTime     DateTime? @map("estimated_arrival_time")
  lastEtaUpdateTime        DateTime? @map("last_eta_update_time")
  etaToOrigin              Int?      @map("eta_to_origin")        // Minutes to pickup
  etaToDestination         Int?      @map("eta_to_destination")   // Minutes to destination
  routeDistanceKm          Float?    @map("route_distance_km")    // Actual road distance from OSRM
  
  // Assignment Management
