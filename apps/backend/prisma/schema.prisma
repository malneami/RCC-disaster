  destinationHospitalId   String?                 @map("destination_hospital_id")
  arrivalDateTime         DateTime                @map("arrival_date_time")
  incidentDateTime        DateTime?               @map("incident_date_time")
  modeOfArrival           TraumaModeOfArrival     @map("mode_of_arrival")
  transferRequestDateTime DateTime?               @map("transfer_request_date_time")
  transferArrivalDateTime DateTime?               @map("transfer_arrival_date_time")
  transferDurationMinutes Int?                    @map("transfer_duration_minutes")
  chiefComplaint          String?                 @map("chief_complaint")
  mechanismOfInjury       TraumaMechanismOfInjury @map("mechanism_of_injury")
  vitalSigns              String?                 @map("vital_signs")
  glasgowComaScale        Int?                    @map("glasgow_coma_scale")
  systolicBloodPressure   Int?                    @map("systolic_blood_pressure")
  respiratoryRate         Int?                    @map("respiratory_rate")
  additionalVitalSigns    String?                 @map("additional_vital_signs")
  primarySurveyFindings   String?                 @map("primary_survey_findings")
  edDisposition           TraumaDispositionType?  @map("ed_disposition")
  additionalNotes         String?                 @map("additional_notes")
  disposition             String?
  responseTimeMinutes     Int?                    @map("response_time_minutes")
  criticalCase            Boolean                 @default(false) @map("critical_case")
  transferCase            Boolean                 @default(false) @map("transfer_case")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  deletedAt               DateTime?               @map("deleted_at")
  createdById             String                  @map("created_by_id")
  headAndNeckInjury       String?                 @map("head_and_neck_injury")
  faceInjury              String?                 @map("face_injury")
  chestInjury             String?                 @map("chest_injury")
  abdomenInjury           String?                 @map("abdomen_injury")
  extremitiesInjury       String?                 @map("extremities_injury")
  externalInjury          String?                 @map("external_injury")
  createdBy               User                    @relation("TraumaCaseCreator", fields: [createdById], references: [id])
  destinationHospital     Hospital?               @relation("TraumaDestinationHospital", fields: [destinationHospitalId], references: [id], onDelete: Cascade)
  originHospital          Hospital                @relation("TraumaOriginHospital", fields: [originHospitalId], references: [id], onDelete: Cascade)
  patient                 Patient                 @relation(fields: [patientId], references: [id])
  ticket                  Ticket?                 @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([patientId])
  @@index([originHospitalId])
  @@index([destinationHospitalId])
  @@index([arrivalDateTime])
  @@index([incidentDateTime])
  @@index([modeOfArrival])
  @@index([mechanismOfInjury])
  @@index([criticalCase])
  @@index([transferCase])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("trauma_cases")
}

// Trauma-specific enums
enum TraumaModeOfArrival {
  AMBULANCE
  PRIVATE_VEHICLE
  AIR_TRANSPORT
  WALK_IN
  POLICE
  TRANSFERRED_FROM_HOSPITAL
  OTHER
}

enum TraumaMechanismOfInjury {
  PENETRATING
  BLUNT
  BURN
  FALL
  MOTOR_VEHICLE_ACCIDENT
  OTHER
}

enum TraumaDispositionType {
  ICU_ADMISSION
  SURGICAL_WARD_ADMISSION
  MEDICAL_WARD_ADMISSION
  DISCHARGE
  OPERATING_THEATRE
  TRANSFER_TO_HIGHER_CENTER
  DEATH
  DISCHARGE_AGAINST_MEDICAL_ADVICE
  OTHER
}


// ambulance.prisma
// Ambulance model for fleet management with GPS tracking
model Ambulance {
  id                      String          @id @default(uuid())
  
  // Vehicle Identification
  vehicleImei             String          @unique @map("vehicle_imei") // GPS device IMEI (15-digit number)
  callSign                String          @unique @map("call_sign") // Radio call sign
  plateNumber             String          @unique @map("plate_number") // License plate
  
  // Vehicle Specifications
  model                   String
  year                    Int
  type                    AmbulanceType
  manufacturer            String?
  vin                     String?         @unique // Vehicle Identification Number
  
  // Location & Status
  baseStation             String          @map("base_station") // Home location/station
  status                  AmbulanceStatus @default(AVAILABLE)
  currentLocationLat      Float?          @map("current_location_lat")
  currentLocationLng      Float?          @map("current_location_lng")
  currentLocationAddress  String?         @map("current_location_address")
  lastUpdated             DateTime?        @map("last_updated")
  
  // Driver Information
  driverName              String?         @map("driver_name")
  driverPhone             String?         @map("driver_phone")
  driverId                String?         @unique @map("driver_id")
  
  // Equipment & Maintenance
  equipmentStatus         EquipmentStatus @default(OPERATIONAL) @map("equipment_status")
  fuelLevel               Float?          @map("fuel_level") // Percentage
  mileage                 Float?          // Odometer reading in km
  lastMaintenanceDate     DateTime?       @map("last_maintenance_date")
  nextMaintenanceDue      DateTime?       @map("next_maintenance_due")
  
  // Operational Status
  isActive                Boolean         @default(true) @map("is_active")
  
  // Audit Fields
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  deletedAt               DateTime?       @map("deleted_at")
  
  // Relations
  driver                  User?           @relation("AmbulanceDriver", fields: [driverId], references: [id])
  assignments             EMSAssignment[]
  gpsTrackingLogs         GPSTrackingLog[]
  driverSchedules         DriverSchedule[]
  equipmentInventory      EquipmentInventory[]
  performanceMetrics      EMSPerformanceMetric[]
  alerts                  EMSAlert[]
  timelineEvents          TimelineEvent[]
  maintenanceRecords      MaintenanceRecord[]
  
  @@map("ambulances")
  @@index([status])
  @@index([baseStation])
  @@index([isActive])
  @@index([vehicleImei])
  @@index([plateNumber])
  @@index([callSign])
  @@index([driverId])
  @@index([nextMaintenanceDue])
}




// driver-schedule.prisma
// Driver Schedule model for managing driver shifts and assignments
model DriverSchedule {
  id                      String          @id @default(uuid())
  
