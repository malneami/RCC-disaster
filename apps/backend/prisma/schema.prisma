  kpi3Percentage                 Float?      @map("kpi3_percentage")
  kpi3Status                     String?     @map("kpi3_status")
  
  kpi4TotalCases                 Int?        @map("kpi4_total_cases") // Stroke unit admission ≤4hr
  kpi4Within4hr                  Int?        @map("kpi4_within_4hr")
  kpi4Percentage                 Float?      @map("kpi4_percentage")
  kpi4Status                     String?     @map("kpi4_status")
  
  kpi5TotalCases                 Int?        @map("kpi5_total_cases") // Dysphagia screening ≤4hr
  kpi5Within4hr                  Int?        @map("kpi5_within_4hr")
  kpi5Percentage                 Float?      @map("kpi5_percentage")
  kpi5Status                     String?     @map("kpi5_status")
  
  kpi6TotalCases                 Int?        @map("kpi6_total_cases") // Early mobilization ≤24hr
  kpi6Within24hr                 Int?        @map("kpi6_within_24hr")
  kpi6Percentage                 Float?      @map("kpi6_percentage")
  kpi6Status                     String?     @map("kpi6_status")
  
  kpi7TotalCases                 Int?        @map("kpi7_total_cases") // Secondary prevention prescribed
  kpi7Prescribed                 Int?        @map("kpi7_prescribed")
  kpi7Percentage                 Float?      @map("kpi7_percentage")
  kpi7Status                     String?     @map("kpi7_status")
  
  kpi8TotalCases                 Int?        @map("kpi8_total_cases") // Appropriate rehabilitation referral
  kpi8Referred                   Int?        @map("kpi8_referred")
  kpi8Percentage                 Float?      @map("kpi8_percentage")
