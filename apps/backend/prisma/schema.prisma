// user.prisma
// User model with comprehensive role management
model User {
  id                String      @id @default(uuid())
  email             String      @unique
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  phoneNumber       String?     @map("phone_number")
  role              UserRole
  status            UserStatus  @default(ACTIVE)
  isEmailVerified   Boolean     @default(false) @map("is_email_verified")
  passwordHash      String      @map("password_hash")
  lastLogin         DateTime?   @map("last_login")
  loginAttempts     Int         @default(0) @map("login_attempts")
  lockedUntil       DateTime?   @map("locked_until")
  passwordResetToken String?    @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")
  refreshToken      String?     @map("refresh_token")
  sessionExpiry     DateTime?   @map("session_expiry")
  hospitalId        String?     @map("hospital_id")
  
  // Audit Fields
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")
  
  // Relations
  hospital          Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  // Ticket Relations
  createdTickets    Ticket[]    @relation("TicketCreator")
  assignedTickets   Ticket[]    @relation("TicketAssignee")
  completedTickets  Ticket[]    @relation("TicketCompleter")
  emsStatusUpdatedTickets Ticket[] @relation("TicketEMSStatusUpdater")
  
  // Patient Relations
  createdPatients   Patient[]   @relation("PatientCreator")
  accessedPatients  Patient[]   @relation("PatientAccessor")
  createdMedicalRecords MedicalRecord[] @relation("MedicalRecordCreator")
  patientAccessLogs PatientAccessLog[]
  
  // Hospital Relations
  createdCriticalCases CriticalCase[] @relation("CriticalCaseCreator")
  createdHospitalTickets HospitalTicket[] @relation("HospitalTicketCreator")
  assignedHospitalTickets HospitalTicket[] @relation("HospitalTicketAssignee")
  
  // Activity Relations
  activities        Activity[]
  
  // Stroke Relations
  createdStrokeCases StrokeCase[] @relation("StrokeCaseCreator")
  triggeredStrokeTimeline StrokeTimeline[] @relation("StrokeTimelineTriggeredBy")
  createdStrokeTimeline StrokeTimeline[] @relation("StrokeTimelineCreator")
  createdStrokeAssessments StrokeAssessmentScore[] @relation("StrokeAssessmentCreator")
  strokeRehabilitationTherapist StrokeRehabilitation[] @relation("StrokeRehabilitationTherapist")
  createdStrokeRehabilitation StrokeRehabilitation[] @relation("StrokeRehabilitationCreator")
  
  // STEMI Relations
  createdStemiCases StemiCase[] @relation("StemiCaseCreator")
  
  // Trauma Relations
  createdTraumaCases TraumaCase[] @relation("TraumaCaseCreator")
  
  // EMS Relations
  ambulanceDriver     Ambulance?         @relation("AmbulanceDriver")
  driverSchedules     DriverSchedule[]   @relation("DriverScheduleDriver")
  emsAssignmentDriver EMSAssignment[]    @relation("EMSAssignmentDriver")
  createdEMSAssignments EMSAssignment[]  @relation("EMSAssignmentCreator")
  emsAlertDriver      EMSAlert[]         @relation("EMSAlertDriver")
  acknowledgedEMSAlerts EMSAlert[]       @relation("EMSAlertAcknowledgedBy")
  createdMaintenanceRecords MaintenanceRecord[] @relation("MaintenanceRecordCreator")
  timelineEventDriver TimelineEvent[]    @relation("TimelineEventDriver")
  triggeredTimelineEvents TimelineEvent[] @relation("TimelineEventTriggeredBy")
  createdTimelineEvents TimelineEvent[]  @relation("TimelineEventCreator")
  
  // Notification Relations
  createdNotifications Notification[]    @relation("NotificationCreator")
  readNotifications    Notification[]    @relation("NotificationReader")
  notificationRecipients NotificationRecipient[] @relation("NotificationRecipientUser")
  createdCaseNotes      CaseNote[]       @relation("CaseNoteCreator")
  caseNoteRecipients    CaseNoteRecipient[] @relation("CaseNoteRecipientUser")
  
  @@map("users")
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([hospitalId])
}


// hospital.prisma
// Hospital model based on CSV data structure
model Hospital {
  id                String        @id @default(uuid())
  name              String
  address           String?
  latitude          Float?
  longitude         Float?
  
  // Bed Capacity - ICU
  icuBeds           Int           @default(0) @map("icu_beds")
  icuBedsAvailable  Int           @default(0) @map("icu_beds_available")
  
  // Bed Capacity - PICU
  picuBeds          Int           @default(0) @map("picu_beds")
  picuBedsAvailable Int           @default(0) @map("picu_beds_available")
  
  // Bed Capacity - Male/Female
  maleBeds          Int           @default(0) @map("male_beds")
  maleBedsAvailable Int           @default(0) @map("male_beds_available")
  femaleBeds        Int           @default(0) @map("female_beds")
  femaleBedsAvailable Int        @default(0) @map("female_beds_available")
  
  // Bed Capacity - Pediatric
  pediatricBeds     Int           @default(0) @map("pediatric_beds")
  pediatricBedsAvailable Int      @default(0) @map("pediatric_beds_available")
  
  // Bed Capacity - Standard
  standardBeds     Int           @default(0) @map("standard_beds")
  standardBedsAvailable Int      @default(0) @map("standard_beds_available")
  
  // Services
  hasStemiService   Boolean       @default(false) @map("has_stemi_service")
  hasStrokeService  Boolean       @default(false) @map("has_stroke_service")
  hasTraumaService  Boolean       @default(false) @map("has_trauma_service")
  
  // Hospital Info
  cluster           String        @default("Jazan")
  status            HospitalStatus @default(AVAILABLE)
  contactPhone      String?       @map("contact_phone")
  contactEmail      String?       @map("contact_email")
  
  // Update tokens
  updateToken       String?       @map("update_token")
  updateTokenExpiry DateTime?     @map("update_token_expiry")
  
  // Emergency Department
  emergencyDeptStatus String      @default("available") @map("emergency_dept_status")
  
  // NICU
  nicuBeds          Int           @default(0) @map("nicu_beds")
  nicuBedsAvailable Int           @default(0) @map("nicu_beds_available")
  
  // Specialized Services
  hasStrokeUnit     Boolean       @default(false) @map("has_stroke_unit")
  traumaLevel       TraumaLevel   @default(NONE) @map("trauma_level")
  hasCardiologyCenter Boolean     @default(false) @map("has_cardiology_center")
  
  // Stroke-specific capabilities
  strokeUnitBeds    Int           @default(0) @map("stroke_unit_beds")
  strokeUnitBedsAvailable Int     @default(0) @map("stroke_unit_beds_available")
  hasThrombolysis   Boolean       @default(false) @map("has_thrombolysis")
  hasThrombectomy   Boolean       @default(false) @map("has_thrombectomy")
  stroke24x7Service Boolean       @default(false) @map("stroke_24x7_service")
  avgDoorToCtScanMinutes Int?    @map("avg_door_to_ct_scan_minutes")
  avgDoorToNeedleMinutes Int?     @map("avg_door_to_needle_minutes")
  avgDoorToMechanicalThrombectomyMinutes Int? @map("avg_door_to_mechanical_thrombectomy_minutes")
  lastStrokeCase    DateTime?     @map("last_stroke_case")
  strokeCasesPerMonth Int         @default(0) @map("stroke_cases_per_month")
  strokeCasesCurrentYear Int      @default(0) @map("stroke_cases_current_year")
  strokeSuccessRate Float?       @map("stroke_success_rate")
  strokeCertificationLevel String? @map("stroke_certification_level") // PRIMARY, COMPREHENSIVE, etc.
  
  // Audit fields
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  
  // Relations
  users             User[]
  originTickets     Ticket[]      @relation("OriginHospital")
  destinationTickets Ticket[]     @relation("DestinationHospital")
  criticalCases     CriticalCase[]
  hospitalTickets   HospitalTicket[]
  
  // Stroke Relations
  strokeOriginCases StrokeCase[]  @relation("StrokeOriginHospital")
  strokeDestinationCases StrokeCase[] @relation("StrokeDestinationHospital")
  strokeKpiSummaries StrokeKpiSummary[]
  strokeRehabilitationCenters StrokeRehabilitation[] @relation("StrokeRehabilitationCenter")
  
  // STEMI Relations
  stemiOriginCases StemiCase[]  @relation("StemiOriginHospital")
  stemiDestinationCases StemiCase[] @relation("StemiDestinationHospital")
  
  // Trauma Relations
  traumaOriginCases TraumaCase[]  @relation("TraumaOriginHospital")
  traumaDestinationCases TraumaCase[] @relation("TraumaDestinationHospital")
  
  @@map("hospitals")
  @@index([status])
  @@index([cluster])
  @@index([hasStemiService])
  @@index([hasStrokeService])
  @@index([hasTraumaService])
}


// patient.prisma
// Enhanced Patient model with comprehensive healthcare data management
model Patient {
  id              String         @id @default(uuid())
  
  // Basic Demographics
  mrn             String?        @unique @map("medical_record_number")
  nationalId      String?        @unique @map("national_id")
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  middleName      String?        @map("middle_name")
  dateOfBirth     DateTime?      @map("date_of_birth") // Will be removed after migration
  age             Int?           // Age in years
  gender          PatientGender
  maritalStatus   MaritalStatus? @map("marital_status")
  
  // Contact Information
  phoneNumber     String?        @map("phone_number")
  email           String?
  address         String?
  city            String?
  state           String?
  zipCode         String?        @map("zip_code")
  country         String?        @default("Saudi Arabia")
  
  // Emergency Contacts
  emergencyContact String?       @map("emergency_contact")
  emergencyPhone  String?        @map("emergency_phone")
  emergencyEmail  String?        @map("emergency_email")
  emergencyRelationship String?  @map("emergency_relationship")
  
  // Insurance Information
  insuranceProvider String?      @map("insurance_provider")
  insuranceNumber   String?      @map("insurance_number")
  insuranceGroup    String?      @map("insurance_group")
  insuranceExpiry   DateTime?    @map("insurance_expiry")
  
  // Medical Information
  bloodType       String?        @map("blood_type")
  rhFactor        String?        @map("rh_factor")
  allergies       String?        // JSON string of allergies
  medications     String?        // JSON string of current medications
  medicalHistory  String?        @map("medical_history")
  riskFactors     String?        @map("risk_factors") // JSON string
  chronicConditions String?      @map("chronic_conditions") // JSON string
  
  // Physical Measurements
  weight          Float?         // in kg
  height          Float?         // in cm
  bmi             Float?         // Calculated BMI
  
  // HIPAA Compliance
  dataEncryptionKey String?      @map("data_encryption_key")
  privacyLevel    PrivacyLevel  @default(PRIVATE) @map("privacy_level")
  consentGiven    Boolean        @default(false) @map("consent_given")
  consentDate     DateTime?      @map("consent_date")
  dataRetentionPolicy String?    @map("data_retention_policy")
  
  // Duplicate Detection
  duplicateGroupId String?       @map("duplicate_group_id")
  isPrimaryRecord Boolean        @default(true) @map("is_primary_record")
  
  // Audit Fields
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")
  createdById     String         @map("created_by_id")
  lastAccessedAt  DateTime?      @map("last_accessed_at")
  lastAccessedBy  String?        @map("last_accessed_by")
  
  // Relations
  createdBy       User           @relation("PatientCreator", fields: [createdById], references: [id])
  lastAccessedByUser User?       @relation("PatientAccessor", fields: [lastAccessedBy], references: [id])
  tickets         Ticket[]
  medicalRecords  MedicalRecord[]
  accessLogs      PatientAccessLog[]
  
  // Stroke Relations
  strokeCases     StrokeCase[]
  strokeAssessmentScores StrokeAssessmentScore[]
  strokeRehabilitation StrokeRehabilitation[]
  
  // STEMI Relations
  stemiCases      StemiCase[]
  
  // Trauma Relations
  traumaCases     TraumaCase[]
  
  // Notification Relations
  notifications   Notification[]
  caseNotes       CaseNote[]
  
  @@map("patients")
  @@index([mrn])
  @@index([nationalId])
  @@index([lastName, firstName])
  @@index([age])
  @@index([duplicateGroupId])
  @@index([createdAt])
  @@index([lastAccessedAt])
}

// Medical Record model for detailed medical history
model MedicalRecord {
  id              String            @id @default(uuid())
  patientId       String            @map("patient_id")
  recordType      MedicalRecordType @map("record_type")
  title           String
  description     String?
  diagnosis       String?
  treatment       String?
  medications     String?           // JSON string
  testResults     String?           // JSON string
  attachments     String?           // JSON string of file paths
  
  // Dates
  recordDate      DateTime          @map("record_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  createdById     String            @map("created_by_id")
  
  // Relations
  patient         Patient           @relation(fields: [patientId], references: [id])
  createdBy       User              @relation("MedicalRecordCreator", fields: [createdById], references: [id])
  
  @@map("medical_records")
  @@index([patientId])
  @@index([recordType])
  @@index([recordDate])
  @@index([createdAt])
}

// Patient Access Log for HIPAA compliance
model PatientAccessLog {
  id              String      @id @default(uuid())
  patientId       String      @map("patient_id")
  userId          String      @map("user_id")
  accessType       AccessType
  accessMethod     String      @map("access_method") // API, WEB, MOBILE
  ipAddress       String?     @map("ip_address")
  userAgent       String?     @map("user_agent")
  reason          String?     // Reason for access
  timestamp       DateTime    @default(now())
  
  // Relations
  patient         Patient     @relation(fields: [patientId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  
  @@map("patient_access_logs")
  @@index([patientId])
  @@index([userId])
  @@index([accessType])
  @@index([timestamp])
}


// ticket.prisma
// Enhanced Ticket model for comprehensive patient transfer management
model Ticket {
  id                  String          @id @default(uuid())
  ticketNumber        String          @unique @map("ticket_number")
  
  // Patient Information
  patientId           String          @map("patient_id")
  
  // Hospital Information
  originHospitalId    String          @map("origin_hospital_id")
  destinationHospitalId String?       @map("destination_hospital_id")
  
  // Ticket Classification
  priority            TicketPriority
  status              TicketStatus    @default(PENDING)
  pathway             TicketPathway  @default(GENERAL)
  
  // Medical Details
  vitals              String?         // JSON string of vital signs
  diagnostics         String?         // JSON string of diagnostic results
  treatmentPlan       String?         @map("treatment_plan")
  
  // Transport Details
  emsContactTime      DateTime?       @map("ems_contact_time")
  actualArrival       DateTime?       @map("actual_arrival")
  transportMode       String?         @map("transport_mode")
  emsUnit             String?         @map("ems_unit")
  transportNotes      String?         @map("transport_notes")
  
  // EMS Status Tracking
  emsAssignmentStatus AssignmentStatus? @map("ems_assignment_status")
  emsStatusUpdatedAt  DateTime?       @map("ems_status_updated_at")
  emsStatusUpdatedBy  String?         @map("ems_status_updated_by")
  
  // Resource Requirements
  requiresBlood       Boolean         @default(false) @map("requires_blood")
  requiresSpecialist  Boolean         @default(false) @map("requires_specialist")
  requiresICU         Boolean         @default(false) @map("requires_icu")
  requiresVentilator  Boolean         @default(false) @map("requires_ventilator")
  requiredResources   String?         @map("required_resources") // JSON string
  
  // Emergency Information
  isEmergency         Boolean         @default(false) @map("is_emergency")
  emergencyType       String?         @map("emergency_type") // STEMI, STROKE, TRAUMA
  emergencySeverity   String?         @map("emergency_severity") // CRITICAL, URGENT, STABLE
  
  // Additional Information
  notes               String?
  internalNotes       String?         @map("internal_notes")
  externalNotes       String?         @map("external_notes")
  
  // Audit Fields
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  createdById         String          @map("created_by_id")
  assignedToId        String?         @map("assigned_to_id")
  completedById       String?         @map("completed_by_id")
  completedAt         DateTime?       @map("completed_at")
  
  // Relations
  patient             Patient         @relation(fields: [patientId], references: [id])
  originHospital      Hospital        @relation("OriginHospital", fields: [originHospitalId], references: [id], onDelete: Cascade)
  destinationHospital Hospital?       @relation("DestinationHospital", fields: [destinationHospitalId], references: [id], onDelete: Cascade)
  createdBy           User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo          User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  completedBy         User?           @relation("TicketCompleter", fields: [completedById], references: [id])
  emsStatusUpdatedByUser User?        @relation("TicketEMSStatusUpdater", fields: [emsStatusUpdatedBy], references: [id])
  activities          Activity[]
  
  // Stroke Relations
  strokeCases         StrokeCase[]
  strokeTimeline      StrokeTimeline[]
  
  // STEMI Relations
  stemiCases          StemiCase[]
  
  // Trauma Relations
  traumaCases         TraumaCase[]
  
  // EMS Relations
  emsAssignments      EMSAssignment[]    @relation("EMSAssignmentTicket")
  timelineEvents      TimelineEvent[]    @relation("TimelineEventTicket")
  
  @@map("tickets")
  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
  @@index([pathway])
  @@index([patientId])
  @@index([originHospitalId])
  @@index([destinationHospitalId])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([isEmergency])
}


// critical-case.prisma
