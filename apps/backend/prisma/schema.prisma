// stroke-case.prisma
// Stroke Case model for comprehensive stroke care management
model StrokeCase {
  id                              String      @id @default(uuid())
  ticketId                        String?     @map("ticket_id")
  patientId                       String      @map("patient_id")
  originHospitalId                String      @map("origin_hospital_id")
  destinationHospitalId           String?     @map("destination_hospital_id")
  
  // Stroke Classification
  strokeType                      StrokeType
  strokeSubtype                   String?     @map("stroke_subtype") // LARGE_VESSEL, SMALL_VESSEL, CARDIOEMBOLIC, etc.
  strokeSeverity                  StrokeSeverity?
  
  // Clinical Assessments
  nihssBaseline                   Int?        @map("nihss_baseline") // 0-42 scale
  nihss24hr                       Int?        @map("nihss_24hr")
  nihssDischarge                  Int?        @map("nihss_discharge")
  mrsBaseline                     Int?        @map("mrs_baseline") // 0-6 scale  
  mrs90day                        Int?        @map("mrs_90day")
  barthelBaseline                 Int?        @map("barthel_baseline") // 0-100 scale
  barthelDischarge                Int?        @map("barthel_discharge")
  aspectsScore                    Int?        @map("aspects_score") // 0-10 scale
  gcsBaseline                     Int?        @map("gcs_baseline") // 3-15 scale
  chiefComplaint                  String?     @map("chief_complaint")
  
  // Patient Arrival & Timing (Step 1)
  modeOfArrival                   StrokeModeOfArrival? @map("mode_of_arrival")
  srcaCallTime                    DateTime?   @map("srca_call_time")
  timeOfSymptomOnset              DateTime?   @map("time_of_symptom_onset")
  lastKnownNormal                 DateTime?   @map("last_known_normal")
  dateOfAdmission              DateTime?   @map("time_of_registration")
  timeOfTriage                    DateTime?   @map("time_of_triage")
  timeOfPhysicianAssessment       DateTime?   @map("time_of_physician_assessment")
  
  // Legacy fields (keeping for backward compatibility)
  presentingSymptoms              String?     @map("presenting_symptoms")
  symptomOnset                    DateTime?   @map("symptom_onset")
  symptomToHospitalMinutes        Int?        @map("symptom_to_hospital_minutes")
  lastKnownWell                   DateTime?   @map("last_known_well")
  wakeUpStroke                    Boolean     @default(false) @map("wake_up_stroke")
  
  // Clinical Assessment & Diagnosis (Step 2)
  strokeTypeDetailed              StrokeTypeDetailed? @map("stroke_type_detailed")
  swallowingScreeningPerformed    Boolean?    @map("swallowing_screening_performed")
  timeOfSwallowingScreening       DateTime?   @map("time_of_swallowing_screening")
  swallowingScreeningResult       SwallowingScreeningResult? @map("swallowing_screening_result")
  ctScanPerformed                 Boolean?    @map("ct_scan_performed")
  timeOfCtScanStart              DateTime?   @map("time_of_ct_scan_start")
  timeOfCtReportFinal            DateTime?   @map("time_of_ct_report_final")
  ctFindings                     CTFindings? @map("ct_findings")
  lvoDetected                    Boolean?    @map("lvo_detected")
  candidateForIVThrombolysis     CandidateAssessment? @map("candidate_for_iv_thrombolysis")
  thrombolysisOrderTime          DateTime?   @map("thrombolysis_order_time")
  ivThrombolysisAdministrationTime DateTime? @map("iv_thrombolysis_administration_time")
  ivThrombolysisGiven            IVThrombolysisGiven? @map("iv_thrombolysis_given")
  reasonForNotAdministeringIV    String?     @map("reason_for_not_administering_iv")
  candidateForMechanicalThrombectomy CandidateAssessment? @map("candidate_for_mechanical_thrombectomy")
  timeOfMechanicalThrombectomyPuncture DateTime? @map("time_of_mechanical_thrombectomy_puncture")
  mechanicalThrombectomyPerformed Boolean?   @map("mechanical_thrombectomy_performed")
  timeOfThrombectomyComplete     DateTime?   @map("time_of_thrombectomy_complete")
  
  // Treatment Details (Legacy)
  currentStatus                   StrokeStatus @map("current_status")
  selectedTreatment               StrokeTreatment? @map("selected_treatment")
  eligibleForThrombolysis         Boolean?    @map("eligible_for_thrombolysis")
  thrombolysisContraindications   String?     @map("thrombolysis_contraindications")
  eligibleForThrombectomy         Boolean?    @map("eligible_for_thrombectomy")
  thrombectomyContraindications   String?     @map("thrombectomy_contraindications")
  
  // Pathway Timings
  pathwayStarted                  DateTime?   @map("pathway_started")
  pathwayCompleted                DateTime?   @map("pathway_completed")
  strokeUnitAdmissionTime         DateTime?   @map("stroke_unit_admission_time")
  
  // Key Performance Timings (minutes)
  doorToCtScanMinutes             Int?        @map("door_to_ct_scan_minutes")
  doorToNeedleMinutes             Int?        @map("door_to_needle_minutes") // For thrombolysis
  doorToMechanicalThrombectomyMinutes Int?    @map("door_to_mechanical_thrombectomy_minutes") // For thrombectomy  
  symptomNeedleMinutes            Int?        @map("symptom_needle_minutes")
  symptomToMechanicalThrombectomyMinutes Int? @map("symptom_to_mechanical_thrombectomy_minutes")
  imagingToNeedleMinutes          Int?        @map("imaging_to_needle_minutes")
  imagingToMechanicalThrombectomyMinutes Int?  @map("imaging_to_mechanical_thrombectomy_minutes")
  
  // Clinical Assessments Timeline  
  dysphagiaScreeningMinutes       Int?        @map("dysphagia_screening_minutes") // From admission
  earlyMobilizationHours          Int?        @map("early_mobilization_hours") // From admission
  speechTherapyHours              Int?        @map("speech_therapy_hours")
  physiotherapyHours              Int?        @map("physiotherapy_hours")
  occupationalTherapyHours        Int?        @map("occupational_therapy_hours")
  
  // CT Scan Results
  ctResults                       String?     @map("ct_results")
  ctaResults                      String?     @map("cta_results")
  ctpResults                      String?     @map("ctp_results")
  mriResults                      String?     @map("mri_results")
  mraResults                      String?     @map("mra_results")
  echocardiogram                  String?
  carotidUcsDoppler               String?     @map("carotid_ucs_doppler")
  
  // Treatment Outcomes
  successful                      Boolean?
  recanalizationGrade             String?     @map("recanalization_grade") // mTICI 0, 1, 2a, 2b, 3
  complications                   String?
  secondaryPrevention             String?     @map("secondary_prevention")
  
  // Disposition & Transfer Decisions (Step 3)
  facilityHasCt                   Boolean?    @map("facility_has_ct")
  transferToAnotherHospital       Boolean?    @map("transfer_to_another_hospital")
  timeOfTransferActivation        DateTime?   @map("time_of_transfer_activation")
  timeOfTransferDeparture         DateTime?   @map("time_of_transfer_departure")
  prehospitalNotificationBySrca  Boolean?    @map("prehospital_notification_by_srca")
  prehospitalNotificationByUccPhc Boolean?    @map("prehospital_notification_by_ucc_phc")
  disposition                     StrokeDisposition? @map("disposition")
  referralTo                      ReferralTo[] @map("referral_to")
  admittedToStrokeUnit            Boolean?    @map("admitted_to_stroke_unit") // Auto-calculated
  
  // Follow-up & Outcome Tracking (Step 4)
  followUpContactAttempted        Boolean?    @map("follow_up_contact_attempted")
  modifiedRankinScaleAt90Days     ModifiedRankinScale? @map("modified_rankin_scale_at_90_days")
  
  // Discharge & Follow-up (Legacy)
  dischargeDestination            String?     @map("discharge_destination") // HOME, REHABILITATION, NURSING_HOME, etc.
  dischargeDate                   DateTime?   @map("discharge_date")
  lengthOfStayDays                Int?        @map("length_of_stay_days")
  thirtyDayReadmission            Boolean?    @map("thirty_day_readmission")
  ninetyDayMortality              Boolean?    @map("ninety_day_mortality")
  followUpCallCompleted           Boolean?    @map("follow_up_call_completed")
  followUpCallDate                DateTime?   @map("follow_up_call_date")
  
  // Stroke Outcome Form Fields
  dischargeType                   String?     @map("discharge_type") // PLANNED, UNPLANNED, AGAINST_MEDICAL_ADVICE, etc.
  followUpNotCompletedReason      String?     @map("follow_up_not_completed_reason")
  followUpSpecify                 String?     @map("follow_up_specify")
  followUpType                    String?     @map("follow_up_type") // PHONE, IN_PERSON, TELEHEALTH, etc.
  dischargeModifiedRankinScale    Int?        @map("discharge_modified_rankin_scale") // 0-6 scale
  followUpModifiedRankinScale     Int?        @map("follow_up_modified_rankin_scale") // 0-6 scale
  closureReport                   String?     @map("closure_report")
  functionalStatus                String?     @map("functional_status") // INDEPENDENT, ASSISTANCE_REQUIRED, DEPENDENT, etc.
  mortality                       String?     @map("mortality") // ALIVE, DEAD, UNKNOWN
  outcomeFormCompleted            Boolean     @default(false) @map("outcome_form_completed")
  outcomeFormCompletionDate       DateTime?   @map("outcome_form_completion_date")
  outcomePercentageCompleteness   Int         @default(0) @map("outcome_percentage_completeness") // 0-100
  
  // KPI Tracking (11 Stroke Toolkit KPIs)
  metKpi1                         Boolean?    @map("met_kpi1") // Median time interval from door to physician ≤15min
  metKpi2                         Boolean?    @map("met_kpi2") // Proportion of transferred patients with pre-hospital notification ≥90%
  metKpi3                         Boolean?    @map("met_kpi3") // Median time interval from registration to CT scan ≤20min
  metKpi4                         Boolean?    @map("met_kpi4") // Median time interval from registration to IV thrombolysis ≤60min
  metKpi5                         Boolean?    @map("met_kpi5") // Proportion of acute ischemic stroke patients who received IV thrombolysis ≥5%
  metKpi6                         Boolean?    @map("met_kpi6") // Proportion of acute stroke patients admitted directly to stroke unit ≥80%
  metKpi7                         Boolean?    @map("met_kpi7") // Median transfer time (door-in to door-out) ≤20min (no CT), ≤40min (with CT)
  metKpi8                         Boolean?    @map("met_kpi8") // Median time interval from registration to mechanical thrombectomy puncture ≤120min
  metKpi9                         Boolean?    @map("met_kpi9") // Median time interval from SRCA call to hospital arrival ≤60min
  metKpi10                        Boolean?    @map("met_kpi10") // Percentage of acute stroke patients who received swallowing screening within 4 hours ≥85%
  metKpi11                        Boolean?    @map("met_kpi11") // Percentage of patients with 3-month follow-up using modified Rankin Scale ≥80%
  
  // KPI Timing Calculations (in minutes)
  doorToPhysicianMinutes          Int?        @map("door_to_physician_minutes")
  doorToCtReportMinutes           Int?        @map("door_to_ct_report_minutes")
  doorToThrombolysisOrderMinutes  Int?        @map("door_to_thrombolysis_order_minutes")
  registrationToCtMinutes         Int?        @map("registration_to_ct_minutes")
  registrationToThrombolysisMinutes Int?      @map("registration_to_thrombolysis_minutes")
  registrationToMechanicalThrombectomyMinutes Int? @map("registration_to_mechanical_thrombectomy_minutes")
  srcaCallToArrivalMinutes        Int?        @map("srca_call_to_arrival_minutes")
  transferActivationToDepartureMinutes Int?   @map("transfer_activation_to_departure_minutes")
  swallowingScreeningWithin4Hours  Boolean?    @map("swallowing_screening_within_4_hours")
  
  // Audit Fields
  createdAt                       DateTime    @default(now()) @map("created_at")
  updatedAt                       DateTime    @updatedAt @map("updated_at")
  deletedAt                       DateTime?   @map("deleted_at")
  createdById                     String      @map("created_by_id")
  
  // Relations
  ticket                          Ticket?      @relation(fields: [ticketId], references: [id])
  patient                         Patient     @relation(fields: [patientId], references: [id])
  originHospital                  Hospital    @relation("StrokeOriginHospital", fields: [originHospitalId], references: [id], onDelete: Cascade)
  destinationHospital             Hospital?   @relation("StrokeDestinationHospital", fields: [destinationHospitalId], references: [id], onDelete: Cascade)
  createdBy                       User        @relation("StrokeCaseCreator", fields: [createdById], references: [id])
  
  // Related Models
  timeline                        StrokeTimeline[]
  timelineEvents                  TimelineEvent[] @relation("TimelineEventStrokeCase")
  assessmentScores                StrokeAssessmentScore[]
  rehabilitation                  StrokeRehabilitation[]
  
  @@map("stroke_cases")
  @@index([ticketId])
  @@index([patientId])
  @@index([originHospitalId])
  @@index([destinationHospitalId])
  @@index([strokeType])
  @@index([strokeSeverity])
  @@index([currentStatus])
  @@index([createdAt])
  @@index([createdById])
}


// stroke-timeline.prisma
