// notifications.prisma
// notifications.prisma
// Notification system for case-related notifications and case notes

// Enums
enum NotificationType {
  CASE_COMMENT
  CASE_UPDATE
  CASE_ASSIGNMENT
  CASE_COMPLETION
  CASE_ESCALATION
  EMS_LATE_CASE
  CRITICAL_CASE_INCOMING
  INCOMPLETE_PATIENT_DATA
  INCOMPLETE_CASE
  KPI_THRESHOLD_BREACH
  CRITICAL_TIME_LIMIT_APPROACHING
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationCategory {
  PATIENTS
  EMS
  HOSPITALS
  TICKETS
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum DeliveryMethod {
  IN_APP
  EMAIL
  SMS
  ALL
}

// Models
model Notification {
  id                      String              @id @default(uuid())
  
  // Notification Details
  type                    NotificationType
  priority                NotificationPriority
  title                   String
  message                 String
  
  // Case References
  caseType                CaseType            @map("case_type") // STEMI, STROKE, TRAUMA
  caseId                  String              @map("case_id") // ID of the specific case
  ticketId                String?             @map("ticket_id") // Optional ticket reference
  
  // Patient Information (denormalized for quick access)
  patientId               String              @map("patient_id")
  patientName             String              @map("patient_name") // "FIRST_NAME LAST_NAME"
  
  // Notification Status
  status                  NotificationStatus  @default(UNREAD)
  isRead                  Boolean             @default(false) @map("is_read")
  readAt                  DateTime?           @map("read_at")
  readBy                  String?             @map("read_by")
  
  // Additional Information
  metadata                String?             // JSON string for additional data
  
  // Category and Source Tracking
  category                NotificationCategory @default(PATIENTS) @map("category")
  sourceEntityType        String?             @map("source_entity_type") 
  sourceEntityId          String?             @map("source_entity_id") 
  escalationLevel         Int?                @map("escalation_level") 
  
  // Audit Fields
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  
  // Relations
  createdBy               User                @relation("NotificationCreator", fields: [createdById], references: [id])
  createdById             String              @map("created_by_id")
  readByUser              User?               @relation("NotificationReader", fields: [readBy], references: [id])
  patient                 Patient             @relation(fields: [patientId], references: [id])
  recipients              NotificationRecipient[]
  
  @@map("notifications")
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([caseType])
  @@index([caseId])
  @@index([patientId])
  @@index([createdAt])
  @@index([isRead])
  @@index([category])
  @@index([sourceEntityType, sourceEntityId])
}

model CaseNote {
  id                      String              @id @default(uuid())
  
  // Note Details
  content                 String
  priority                NotificationPriority
  
  // Case References
  caseType                CaseType            @map("case_type") // STEMI, STROKE, TRAUMA
  caseId                  String              @map("case_id") // ID of the specific case
  ticketId                String?             @map("ticket_id") // Optional ticket reference
  
  // Patient Information (denormalized for quick access)
  patientId               String              @map("patient_id")
  patientName             String              @map("patient_name") // "FIRST_NAME LAST_NAME"
  
  // Notification Settings
  notifyTeam              Boolean             @default(true) @map("notify_team")
  
  // Additional Information
  metadata                String?             // JSON string for additional data
  
  // Audit Fields
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  
  // Relations
  createdBy               User                @relation("CaseNoteCreator", fields: [createdById], references: [id])
  createdById             String              @map("created_by_id")
  patient                 Patient             @relation(fields: [patientId], references: [id])
  recipients              CaseNoteRecipient[]
  replies                 Reply[]
  
  @@map("case_notes")
  @@index([caseType])
  @@index([caseId])
  @@index([patientId])
  @@index([createdAt])
}

model NotificationRecipient {
  id                      String              @id @default(uuid())
  
  // References
  notificationId          String              @map("notification_id")
  userId                  String              @map("user_id")
  
  // Delivery Status
  deliveryStatus          DeliveryStatus      @default(PENDING)
  deliveryMethod          DeliveryMethod      @default(IN_APP)
  
  // Email/SMS specific fields
  emailSent               Boolean             @default(false) @map("email_sent")
  emailSentAt             DateTime?           @map("email_sent_at")
  smsSent                 Boolean             @default(false) @map("sms_sent")
  smsSentAt               DateTime?           @map("sms_sent_at")
  
  // Read Status
  isRead                  Boolean             @default(false) @map("is_read")
  readAt                  DateTime?           @map("read_at")
  
  // Soft Delete
  deletedAt               DateTime?           @map("deleted_at")
  
  // Audit Fields
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  
  // Relations
  notification            Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user                    User                @relation("NotificationRecipientUser", fields: [userId], references: [id])
  
  @@map("notification_recipients")
  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([deliveryStatus])
  @@index([isRead])
}

model CaseNoteRecipient {
  id                      String              @id @default(uuid())
  
  // References
  caseNoteId              String              @map("case_note_id")
  userId                  String              @map("user_id")
  
  // Delivery Status
  deliveryStatus          DeliveryStatus      @default(PENDING)
  deliveryMethod          DeliveryMethod      @default(IN_APP)
  
  // Email/SMS specific fields
  emailSent               Boolean             @default(false) @map("email_sent")
  emailSentAt             DateTime?           @map("email_sent_at")
  smsSent                 Boolean             @default(false) @map("sms_sent")
  smsSentAt               DateTime?           @map("sms_sent_at")
  
  // Read Status
  isRead                  Boolean             @default(false) @map("is_read")
  readAt                  DateTime?           @map("read_at")
  
  // Audit Fields
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  
  // Relations
  caseNote                CaseNote            @relation(fields: [caseNoteId], references: [id], onDelete: Cascade)
  user                    User                @relation("CaseNoteRecipientUser", fields: [userId], references: [id])
  
  @@map("case_note_recipients")
  @@unique([caseNoteId, userId])
  @@index([caseNoteId])
  @@index([userId])
  @@index([deliveryStatus])
  @@index([isRead])
}

model Reply {
  id                      String              @id @default(uuid())
  
  // Reply Details
  content                 String
  priority                NotificationPriority @default(MEDIUM)
  
  // Parent References
  caseNoteId              String              @map("case_note_id")
  parentReplyId           String?             @map("parent_reply_id") // For nested replies
  
  // Case References (denormalized for quick access)
  caseType                CaseType            @map("case_type")
  caseId                  String              @map("case_id")
  patientId               String              @map("patient_id")
  patientName             String              @map("patient_name")
  
  // Reply Status
  isEdited                Boolean             @default(false) @map("is_edited")
  editedAt                DateTime?           @map("edited_at")
  
  // Soft Delete
  deletedAt               DateTime?           @map("deleted_at")
  
  // Additional Information
  metadata                String?             // JSON string for additional data
  
  // Audit Fields
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  
  // Relations
  createdBy               User                @relation("ReplyCreator", fields: [createdById], references: [id])
  createdById             String              @map("created_by_id")
  caseNote                CaseNote            @relation(fields: [caseNoteId], references: [id], onDelete: Cascade)
  patient                 Patient             @relation(fields: [patientId], references: [id])
  parentReply             Reply?              @relation("ReplyThread", fields: [parentReplyId], references: [id])
  childReplies            Reply[]             @relation("ReplyThread")
  
  @@map("replies")
  @@index([caseNoteId])
  @@index([parentReplyId])
  @@index([caseType])
  @@index([caseId])
  @@index([patientId])
  @@index([createdAt])
  @@index([deletedAt])
}

// disaster.prisma
// Disaster Management System - Enums and Models
// RTA/MCI (Road Traffic Accident / Mass Casualty Incident) and Code Yellow incidents

enum DisasterScope {
  INTERNAL
  EXTERNAL
}

enum DisasterIncidentType {
  // External (community) disaster types
  RTA_MCI
  CODE_YELLOW
  EARTHQUAKE
  FLOOD
  FIRE
  CHEMICAL_SPILL
  OUTBREAK
  // Internal (hospital) disaster types
  INTERNAL_FIRE
  SMOKE_ELECTRICAL_FAILURE
  POWER_FAILURE
  WATER_LEAKAGE_FLOODING
  IT_SYSTEM_FAILURE
}

enum TriageColorCode {
  GREEN
  YELLOW
  RED
  BLACK
}

enum DisasterStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum DisasterAnnouncementStatus {
  QUEUED
  SENT
  FAILED
}

// Disaster ambulance assignment status - workflow progression
enum DisasterAssignmentStatus {
  EN_ROUTE             // Heading to MCI scene
  AT_SCENE             // Arrived at MCI (arrivedAt set)
  PATIENT_LOADED       // Patient(s) loaded, ready to depart
  EN_ROUTE_TO_HOSPITAL // En route to destination hospital
  ARRIVED              // Delivered to destination hospital
}

enum DisasterNotificationType {
  INCIDENT_CREATED
  ANNOUNCEMENT_SENT
  AMBULANCE_ASSIGNED
  INCIDENT_RESOLVED
}

enum DisasterNotificationStatus {
  UNREAD
  READ
}

// Command Room - Operational war-room during major incidents
enum DisasterCommandRole {
  COMMANDER
  OPERATIONS_LEAD
  EMS_COORDINATOR
  HOSPITAL_COORDINATION_LEAD
  SITUATION_ANALYST
  RECORDER
}

enum DisasterEscalationLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum DisasterCommandDecisionAction {
  ACTIVATED
  ESCALATED
  TEAM_ASSIGNED
  CLOSED
  CUSTOM
}

model DisasterIncident {
  id                    String               @id @default(uuid())
  disasterScope         DisasterScope        @default(EXTERNAL) @map("disaster_scope")
  incidentType          DisasterIncidentType  @map("incident_type")
  colorCode             TriageColorCode?     @map("color_code") // For RTA_MCI
  status                DisasterStatus       @default(ACTIVE)
  locationLat           Float                @map("location_lat")
  locationLng           Float                @map("location_lng")
  locationAddress       String?              @map("location_address")
  locationDescription   String?              @map("location_description")
  estimatedGreen        Int                  @default(0) @map("estimated_green")
  estimatedYellow       Int                  @default(0) @map("estimated_yellow")
  estimatedRed          Int                  @default(0) @map("estimated_red")
  estimatedBlack        Int                  @default(0) @map("estimated_black")
  estimatedETA          DateTime?            @map("estimated_eta")
  notes                 String?
  createdById           String               @map("created_by_id")
  resolvedById          String?              @map("resolved_by_id")
  resolvedAt            DateTime?            @map("resolved_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  createdBy             User                 @relation("DisasterIncidentCreator", fields: [createdById], references: [id])
  resolvedBy            User?                @relation("DisasterIncidentResolver", fields: [resolvedById], references: [id])
  ambulanceAssignments  DisasterAmbulanceAssignment[]
  announcements         DisasterAnnouncement[]
  auditLogs             DisasterAuditLog[]
  disasterNotifications DisasterNotification[]
  disasterMessages      DisasterMessage[]
  commandRoom           DisasterCommandRoom?

  @@map("disaster_incidents")
  @@index([status])
  @@index([incidentType])
  @@index([createdAt])
  @@index([createdById])
}

model DisasterAmbulanceAssignment {
  id                      String                   @id @default(uuid())
  disasterIncidentId      String                   @map("disaster_incident_id")
  ambulanceId             String                   @map("ambulance_id")
  assignedById            String                   @map("assigned_by_id")
  triageCategory          TriageColorCode?         @map("triage_category") // RED, YELLOW, GREEN, BLACK for MCI
  destinationHospitalId   String?                  @map("destination_hospital_id")
  distanceKm              Float?                   @map("distance_km")
  status                  DisasterAssignmentStatus @default(EN_ROUTE)
  assignedAt              DateTime                 @default(now()) @map("assigned_at")
  arrivedAt               DateTime?                @map("arrived_at")

  disasterIncident        DisasterIncident @relation(fields: [disasterIncidentId], references: [id], onDelete: Cascade)
  ambulance               Ambulance        @relation(fields: [ambulanceId], references: [id])
  assignedBy              User             @relation("DisasterAmbulanceAssignor", fields: [assignedById], references: [id])
  destinationHospital     Hospital?        @relation("DisasterDestinationHospital", fields: [destinationHospitalId], references: [id])

  @@map("disaster_ambulance_assignments")
  @@index([disasterIncidentId])
  @@index([ambulanceId])
}

model DisasterAnnouncement {
  id                    String                   @id @default(uuid())
  disasterIncidentId    String                   @map("disaster_incident_id")
  templateType          DisasterIncidentType     @map("template_type")
  announcementText      String                   @map("announcement_text")
  status                DisasterAnnouncementStatus @default(QUEUED)
  createdById           String                   @map("created_by_id")
  approvedById          String?                  @map("approved_by_id")
  approvedAt            DateTime?                @map("approved_at")
  broadcastedAt         DateTime?                @map("broadcasted_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  disasterIncident      DisasterIncident         @relation(fields: [disasterIncidentId], references: [id], onDelete: Cascade)
  createdBy             User                     @relation("DisasterAnnouncementCreator", fields: [createdById], references: [id])
  approvedBy            User?                    @relation("DisasterAnnouncementApprover", fields: [approvedById], references: [id])
  hospitalLogs          DisasterAnnouncementHospitalLog[]

  @@map("disaster_announcements")
  @@index([disasterIncidentId])
  @@index([status])
}

model DisasterAnnouncementHospitalLog {
  id                    String                   @id @default(uuid())
  announcementId        String                   @map("announcement_id")
  hospitalId            String                   @map("hospital_id")
  status                DisasterAnnouncementStatus @default(QUEUED)
  sentAt                DateTime?                @map("sent_at")
  createdAt             DateTime                 @default(now()) @map("created_at")

  announcement          DisasterAnnouncement     @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  hospital              Hospital                 @relation(fields: [hospitalId], references: [id])

  @@map("disaster_announcement_hospital_logs")
  @@index([announcementId])
  @@index([hospitalId])
}

model DisasterAuditLog {
  id                    String    @id @default(uuid())
  disasterIncidentId    String?   @map("disaster_incident_id")
  userId                String    @map("user_id")
  action                String
  details               String?
  createdAt             DateTime  @default(now()) @map("created_at")

  disasterIncident      DisasterIncident? @relation(fields: [disasterIncidentId], references: [id], onDelete: SetNull)
  user                  User      @relation(fields: [userId], references: [id])

  @@map("disaster_audit_logs")
  @@index([disasterIncidentId])
  @@index([userId])
  @@index([createdAt])
}

model DisasterNotification {
  id                    String                      @id @default(uuid())
  disasterIncidentId    String                      @map("disaster_incident_id")
  type                  DisasterNotificationType
  priority              NotificationPriority
  title                 String
  message               String
  status                DisasterNotificationStatus  @default(UNREAD)
  createdById           String                      @map("created_by_id")
  createdAt             DateTime                    @default(now()) @map("created_at")

  disasterIncident      DisasterIncident            @relation(fields: [disasterIncidentId], references: [id], onDelete: Cascade)
  createdBy             User                        @relation("DisasterNotificationCreator", fields: [createdById], references: [id])
  recipients            DisasterNotificationRecipient[]

  @@map("disaster_notifications")
  @@index([disasterIncidentId])
  @@index([createdById])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

model DisasterNotificationRecipient {
  id              String         @id @default(uuid())
  notificationId  String         @map("notification_id")
  userId          String         @map("user_id")
  isRead          Boolean        @default(false) @map("is_read")
  readAt          DateTime?      @map("read_at")
  deliveryMethod  DeliveryMethod @default(IN_APP) @map("delivery_method")

  notification    DisasterNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user            User                 @relation("DisasterNotificationRecipientUser", fields: [userId], references: [id])

  @@map("disaster_notification_recipients")
  @@unique([notificationId, userId])
  @@index([notificationId])
  @@index([userId])
  @@index([isRead])
}

model DisasterMessage {
  id                    String           @id @default(uuid())
  disasterIncidentId    String           @map("disaster_incident_id")
  content               String
  createdById           String           @map("created_by_id")
  createdAt             DateTime         @default(now()) @map("created_at")

  disasterIncident      DisasterIncident @relation(fields: [disasterIncidentId], references: [id], onDelete: Cascade)
  createdBy             User             @relation("DisasterMessageCreator", fields: [createdById], references: [id])

  @@map("disaster_messages")
  @@index([disasterIncidentId])
  @@index([createdById])
  @@index([createdAt])
}

model DisasterCommandRoom {
  id                    String                     @id @default(uuid())
  disasterIncidentId    String                     @unique @map("disaster_incident_id")
  escalationLevel       DisasterEscalationLevel    @default(LEVEL_1) @map("escalation_level")
  activatedById         String                     @map("activated_by_id")
  activatedAt           DateTime                   @default(now()) @map("activated_at")
  closedById            String?                    @map("closed_by_id")
  closedAt              DateTime?                  @map("closed_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  disasterIncident      DisasterIncident           @relation(fields: [disasterIncidentId], references: [id], onDelete: Cascade)
  activatedBy           User                       @relation("DisasterCommandRoomActivator", fields: [activatedById], references: [id])
  closedBy              User?                      @relation("DisasterCommandRoomCloser", fields: [closedById], references: [id])
  roleAssignments       DisasterCommandRoleAssignment[]
  decisionLogs          DisasterCommandDecisionLog[]

  @@map("disaster_command_rooms")
  @@index([disasterIncidentId])
  @@index([activatedById])
}

model DisasterCommandRoleAssignment {
  id                    String                 @id @default(uuid())
  commandRoomId         String                 @map("command_room_id")
  userId                String                 @map("user_id")
  role                  DisasterCommandRole
  assignedById          String                 @map("assigned_by_id")
  assignedAt            DateTime               @default(now()) @map("assigned_at")

  commandRoom           DisasterCommandRoom    @relation(fields: [commandRoomId], references: [id], onDelete: Cascade)
  user                  User                   @relation("DisasterCommandRoleUser", fields: [userId], references: [id])
  assignedBy            User                   @relation("DisasterCommandRoleAssignor", fields: [assignedById], references: [id])

  @@map("disaster_command_role_assignments")
  @@unique([commandRoomId, role])
  @@index([commandRoomId])
  @@index([userId])
}

model DisasterCommandDecisionLog {
  id                    String                     @id @default(uuid())
  commandRoomId         String                     @map("command_room_id")
  userId                String                     @map("user_id")
  action                DisasterCommandDecisionAction
  details               Json?                      // Custom details for CUSTOM action
  createdAt             DateTime                   @default(now()) @map("created_at")

  commandRoom           DisasterCommandRoom        @relation(fields: [commandRoomId], references: [id], onDelete: Cascade)
  user                  User                       @relation("DisasterCommandDecisionUser", fields: [userId], references: [id])

  @@map("disaster_command_decision_logs")
  @@index([commandRoomId])
  @@index([userId])
  @@index([createdAt])
}


// mcp-audit.prisma
// MCP Data Quality Audit models

enum AuditDimension {
  COMPLETENESS
  ACCURACY
  CONSISTENCY
  TIMELINESS
  COMPLIANCE
  INTEGRITY
}

enum AuditEventType {
  SCHEDULED_AUDIT
  REAL_TIME_EVENT
  MANUAL_TRIGGER
  SYSTEM_CHECK
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model AuditEvent {
  id             String           @id @default(uuid())
  eventType      AuditEventType     @map("event_type")
  dimension      AuditDimension
  entityType     String           @map("entity_type")
  entityId       String           @map("entity_id")
  severity       AuditSeverity
  description    String
  details        Json?
  mcpSubmitted   Boolean          @default(false) @map("mcp_submitted")
  mcpResponse    Json?            @map("mcp_response")
  mcpSubmittedAt DateTime?        @map("mcp_submitted_at")
  createdById    String?          @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  createdBy      User?            @relation("AuditEventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("audit_events")
  @@index([eventType])
  @@index([dimension])
  @@index([severity])
  @@index([entityType])
  @@index([createdAt])
  @@index([createdById])
}

model AuditReport {
  id              String    @id @default(uuid())
  reportNumber    String    @unique @map("report_number")
  reportType      String    @map("report_type")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  overallScore    Float     @map("overall_score")
  dimensionScores Json      @map("dimension_scores")
  summary         Json
  mcpReportUrl    String?   @map("mcp_report_url")
  generatedById   String?   @map("generated_by_id")
  generatedAt     DateTime  @default(now()) @map("generated_at")

  generatedBy     User?     @relation("AuditReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@map("audit_reports")
  @@index([reportType])
  @@index([generatedAt])
  @@index([generatedById])
}


// support-ticket.prisma
model SupportTicket {
  id              String                @id @default(uuid())
  ticketNumber    String                @unique @map("ticket_number")
  
  description     String                
  category        SupportTicketCategory 
  status          SupportTicketStatus   @default(OPEN)
  
  // Relations
  createdBy       User                  @relation("SupportTicketCreator", fields: [createdById], references: [id])
  createdById     String                @map("created_by_id")
  
  messages        SupportMessage[]
  attachments     SupportAttachment[]
  
  // Audit Fields
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  resolvedAt      DateTime?             @map("resolved_at")
  resolvedById    String?               @map("resolved_by_id")
  resolvedBy      User?                 @relation("SupportTicketResolver", fields: [resolvedById], references: [id])
  
  @@map("support_tickets")
  @@index([ticketNumber])
  @@index([status])
  @@index([category])
  @@index([createdById])
  @@index([createdAt])
}

model SupportMessage {
  id              String                @id @default(uuid())
  ticketId        String                @map("ticket_id")
  content         String                
  senderType      MessageSenderType     @map("sender_type")
  
  // Relations
  ticket          SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender          User                  @relation("SupportMessageSender", fields: [senderId], references: [id])
  senderId        String                @map("sender_id")
  
  attachments     SupportAttachment[]
  
  // Audit Fields
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  
  @@map("support_messages")
  @@index([ticketId])
  @@index([senderId])
  @@index([senderType])
  @@index([createdAt])
}

model SupportAttachment {
  id              String                @id @default(uuid())
  ticketId        String                @map("ticket_id")
  messageId       String?               @map("message_id") 
  
  // File Details
  fileName        String                @map("file_name")
  mimeType        String                @map("mime_type")
  fileSize        Int                   @map("file_size") 
  fileData        String                @map("file_data") 
  
  // Relations
  ticket          SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message         SupportMessage?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  // Audit Fields
  uploadedAt      DateTime              @default(now()) @map("uploaded_at")
  uploadedBy      User                  @relation("SupportAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedById    String                @map("uploaded_by_id")
  
  @@map("support_attachments")
  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedById])
  @@index([uploadedAt])
}



// unit.prisma
model Unit {
  id          String    @id @default(uuid())
  hospitalId  String    @map("hospital_id")
  name        String    // e.g., "ICU Unit", "PICU Unit"
  bedType     BedType   @map("bed_type")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  // Relations
  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  beds        Bed[]
  bedRequests BedRequest[]
  
  @@map("units")
  @@index([hospitalId])
  @@index([bedType])
  @@index([isActive])
  @@unique([hospitalId, bedType])
}

// bed.prisma
model Bed {
  id                  String            @id @default(uuid())
  unitId              String            @map("unit_id")
  hospitalId          String            @map("hospital_id")
  bedNumber           String            // e.g., "ICU-01", "PICU-02"
  status              BedStatus         @default(VACANT)
  location            String?           
  notes               String?
  isOperational       Boolean           @default(true) @map("is_operational")
  currentPatientId    String?           @map("current_patient_id")
  currentBedRequestId String?           @unique @map("current_bed_request_id")
  caseId              String?           @map("case_id")
  caseType            CaseType?         @map("case_type")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")
  
  // Relations
  unit                Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hospital            Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  currentPatient      Patient?          @relation(fields: [currentPatientId], references: [id], onDelete: SetNull)
  currentBedRequest   BedRequest?       @relation("CurrentBedRequest", fields: [currentBedRequestId], references: [id], onDelete: SetNull)
  bedStatusHistory    BedStatusHistory[]
  assignedBedRequests BedRequest[]      @relation("AssignedBed")
  
  @@map("beds")
  @@index([unitId])
  @@index([hospitalId])
  @@index([status])
  @@index([bedNumber])
  @@index([currentPatientId])
  @@index([caseId])
  @@index([caseType])
  @@unique([unitId, bedNumber])
}

// bed-request.prisma
model BedRequest {
  id              String              @id @default(uuid())
  requestNumber   String              @unique @map("request_number") // e.g., "BR-20240101-001"
  hospitalId      String              @map("hospital_id")
  unitId          String              @map("unit_id")
  patientId       String              @map("patient_id")
  requestedById   String              @map("requested_by_id")
  priority        BedRequestPriority  @default(MEDIUM)
  status          BedRequestStatus    @default(PENDING)
  requestedAt     DateTime            @default(now()) @map("requested_at")
  approvedAt      DateTime?           @map("approved_at")
  approvedById    String?             @map("approved_by_id")
  assignedAt      DateTime?           @map("assigned_at")
  assignedById    String?            @map("assigned_by_id")
  assignedBedId   String?            @unique @map("assigned_bed_id")
  arrivedAt       DateTime?          @map("arrived_at")
  dischargedAt    DateTime?          @map("discharged_at")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  
  // Relations
  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  unit            Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedBy     User                @relation("BedRequestRequester", fields: [requestedById], references: [id])
  approvedBy      User?               @relation("BedRequestApprover", fields: [approvedById], references: [id])
  assignedBy      User?               @relation("BedRequestAssigner", fields: [assignedById], references: [id])
  assignedBed     Bed?                @relation("AssignedBed", fields: [assignedBedId], references: [id], onDelete: SetNull)
  currentBedFor   Bed?                @relation("CurrentBedRequest")
  
  @@map("bed_requests")
  @@index([hospitalId])
  @@index([unitId])
  @@index([patientId])
  @@index([status])
  @@index([priority])
  @@index([requestedAt])
  @@index([requestNumber])
}

// bed-status-history.prisma
model BedStatusHistory {
  id            String      @id @default(uuid())
  bedId         String      @map("bed_id")
  patientId     String?     @map("patient_id")
  caseId        String?     @map("case_id")
  caseType      CaseType?   @map("case_type")
  previousStatus BedStatus? @map("previous_status")
  newStatus     BedStatus   @map("new_status")
  changedById   String      @map("changed_by_id")
  changedAt     DateTime    @default(now()) @map("changed_at")
  reason        String?
  notes         String?
  
  // Relations
  bed           Bed         @relation(fields: [bedId], references: [id], onDelete: Cascade)
  changedBy     User        @relation("BedStatusChanger", fields: [changedById], references: [id])
  patient       Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  
  @@map("bed_status_history")
  @@index([bedId])
  @@index([changedAt])
  @@index([changedById])
  @@index([newStatus])
  @@index([bedId, changedAt])
  @@index([patientId])
  @@index([caseId])
  @@index([caseType])
}

// recordings.prisma
model Recording {
  id              String        @id @default(uuid())
  filename        String        @unique
  path            String
  size            Int
  duration        Int?          @default(0)
  roomId          String        @map("room_id")
  egressId        String?       @map("egress_id")
  callerId        String        @map("caller_id")
  calleeId        String        @map("callee_id")
  recordingType   RecordingType @default(AUDIO) @map("recording_type")
  fileFormat      String        @default("mp4") @map("file_format")
  upgradedToVideo Boolean       @default(false) @map("upgraded_to_video")
  
  // Video recording fields (for dual recording)
  videoFilename   String?       @map("video_filename")
  videoPath       String?       @map("video_path")
  videoEgressId   String?       @map("video_egress_id")
  videoSize       Int?          @map("video_size")
  videoDuration   Int?          @map("video_duration")
  
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  // Relations
  caller          User                    @relation("RecordingCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee          User                    @relation("RecordingCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  participants    RecordingParticipant[]
  transcripts     RecordingTranscript[]

  @@map("recordings")
  @@index([roomId])
  @@index([callerId])
  @@index([calleeId])
  @@index([egressId])
  @@index([videoEgressId])
  @@index([createdAt])
  @@index([deletedAt])
}

// Many-to-many relation for recording participants
model RecordingParticipant {
  id          String    @id @default(uuid())
  recordingId String    @map("recording_id")
  userId      String    @map("user_id")
  role        String    // "caller" | "callee" | "participant"
  
  // Relations
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user        User      @relation("RecordingParticipants", fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("recording_participants")
  @@unique([recordingId, userId])
  @@index([recordingId])
  @@index([userId])
}

// transcripts.prisma
model RecordingTranscript {
  id            String             @id @default(uuid())
  recordingId   String?            @map("recording_id")
  roomId        String             @map("room_id")
  provider      TranscriptProvider @map("provider")
  status        TranscriptStatus   @map("status")
  languageCode  String             @map("language_code")
  fullText      String?            @db.Text @map("full_text")
  errorMessage  String?            @db.Text @map("error_message")
  startedAt     DateTime?          @map("started_at")
  completedAt   DateTime?          @map("completed_at")
  deletedAt     DateTime?          @map("deleted_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  // Relations
  recording     Recording?                  @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  segments      RecordingTranscriptSegment[]

  @@map("recording_transcripts")
  @@index([roomId])
  @@index([recordingId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model RecordingTranscriptSegment {
  id            String              @id @default(uuid())
  transcriptId  String              @map("transcript_id")
  speakerUserId String?             @map("speaker_user_id")
  speakerLabel  String?             @map("speaker_label")
  startMs       Int                 @map("start_ms")
  endMs         Int                 @map("end_ms")
  text          String              @db.Text @map("text")
  confidence    Float?              @map("confidence")
  isFinal       Boolean             @map("is_final")
  createdAt     DateTime            @default(now()) @map("created_at")

  // Relations
  transcript    RecordingTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  speaker       User?               @relation("SegmentSpeaker", fields: [speakerUserId], references: [id], onDelete: SetNull)

  @@map("recording_transcript_segments")
  @@index([transcriptId])
  @@index([speakerUserId])
  @@index([startMs])
}

