// Stroke Timeline model for tracking stroke care events
model StrokeTimeline {
  id                      String          @id @default(uuid())
  strokeCaseId            String          @map("stroke_case_id")
  ticketId                String          @map("ticket_id")
  
  // Status Tracking
  fromStatus              StrokeStatus?   @map("from_status")
  toStatus                StrokeStatus    @map("to_status")
  
  // Event Details
  eventTimestamp          DateTime        @map("event_timestamp")
  eventDescription        String          @map("event_description")
  eventLocation           String?         @map("event_location") // ED, CT_SUITE, ANGIO_SUITE, STROKE_UNIT
  eventType               StrokeEventType @map("event_type")
  triggeredBy             String          @map("triggered_by")
  
  // Timing Metrics
  minutesFromSymptom      Int?            @map("minutes_from_symptom")
  minutesFromAdmission    Int?            @map("minutes_from_admission")
  withinTarget            Boolean?        @map("within_target")
  targetMinutes           Int?            @map("target_minutes")
  
  // Clinical Context
  nihssAtSession          Int?            @map("nihss_at_session")
  clinicalNotes           String?         @map("clinical_notes")
  
  // Audit Fields
  createdAt               DateTime        @default(now()) @map("created_at")
  createdById             String          @map("created_by_id")
  
  // Relations
  strokeCase              StrokeCase      @relation(fields: [strokeCaseId], references: [id])
  ticket                  Ticket          @relation(fields: [ticketId], references: [id])
  triggeredByUser         User            @relation("StrokeTimelineTriggeredBy", fields: [triggeredBy], references: [id])
  createdBy               User            @relation("StrokeTimelineCreator", fields: [createdById], references: [id])
  
  @@map("stroke_timeline")
  @@index([strokeCaseId])
  @@index([ticketId])
  @@index([eventTimestamp])
  @@index([eventType])
  @@index([toStatus])
  @@index([createdAt])
}
