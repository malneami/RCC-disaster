// EMS Assignment model for managing ambulance and driver assignments
model EMSAssignment {
  id                      String          @id @default(uuid())
  
  // Assignment Details
  ticketId                String          @map("ticket_id")
  ambulanceId             String?         @map("ambulance_id")
  driverId                String?         @map("driver_id")
  
  // Timing Information
  assignedAt              DateTime        @map("assigned_at")
  status                  AssignmentStatus @default(EMS_CONTACT)
  emsContactTime          DateTime?       @map("ems_contact_time")
  actualArrivalTime       DateTime?       @map("actual_arrival_time")
  journeyStartTime        DateTime?       @map("journey_start_time")
  journeyEndTime          DateTime?       @map("journey_end_time")
  
  // Journey Details
  distanceKm              Float?          @map("distance_km")
  notes                   String?
  
  // Assignment Management
  createdBy               String          @map("created_by")
  
  // Audit Fields
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  deletedAt               DateTime?       @map("deleted_at")
  
  // Relations
  ticket                  Ticket          @relation("EMSAssignmentTicket", fields: [ticketId], references: [id])
  ambulance               Ambulance?      @relation(fields: [ambulanceId], references: [id])
  driver                  User?           @relation("EMSAssignmentDriver", fields: [driverId], references: [id])
  createdByUser           User            @relation("EMSAssignmentCreator", fields: [createdBy], references: [id])
  
  @@map("ems_assignments")
  @@index([ticketId])
  @@index([ambulanceId])
  @@index([driverId])
  @@index([status])
  @@index([assignedAt])
  @@index([createdAt])
}


