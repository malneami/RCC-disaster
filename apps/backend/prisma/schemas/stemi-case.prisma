// STEMI Case model for comprehensive STEMI care management
model StemiCase {
  id                              String      @id @default(uuid())
  ticketId                        String?     @map("ticket_id")
  patientId                       String      @map("patient_id")
  originHospitalId                String      @map("origin_hospital_id")
  destinationHospitalId           String?     @map("destination_hospital_id")
  
  // Clinical Assessment
  heartScore                      Int?        @map("heart_score") // TIMI Risk Score
  clinicalRiskLevel               String?     @map("clinical_risk_level") // Low, Intermediate, High, Very High
  presentingSymptoms              String?     @map("presenting_symptoms")
  symptomOnset                    DateTime?   @map("symptom_onset")
  symptomDuration                 Int?        @map("symptom_duration") // in minutes
  
  // Pathway Execution
  currentStatus                   String      @map("current_status") // SUSPECTED, ECG_PENDING, STEMI_CONFIRMED, etc.
  selectedTreatment               String?     @map("selected_treatment") // PRIMARY_PCI, RESCUE_PCI, FIBRINOLYSIS, etc.
  pathwayStarted                  DateTime?   @map("pathway_started")
  pathwayCompleted                DateTime?   @map("pathway_completed")
  modeOfArrival                   String?     @map("mode_of_arrival") // AMBULANCE, PRIVATE_VEHICLE, AIR_TRANSPORT, etc.
  rccActivated                    Boolean     @default(false) @map("rcc_activated")
  rccUnit                         String?     @map("rcc_unit")
  caseType                        String      @default("DIRECT") @map("case_type") // DIRECT or TRANSFER
  
  // Critical Timestamps
  triageTime                      DateTime?   @map("triage_time")
  firstEcgTime                    DateTime?   @map("first_ecg_time")
  
  // ECG Results
  ecgResult                       String?     @map("ecg_result") // PENDING, NORMAL, STEMI_ANTERIOR, etc.
  ecgFindings                     String?     @map("ecg_findings")
  
  // Interventions and Treatments
  eligibleForPrimaryPci           Boolean?    @map("eligible_for_primary_pci")
  pciLocation                     String?     @map("pci_location")
  doorOutTime                     DateTime?   @map("door_out_time")
  balloonInflationTime            DateTime?   @map("balloon_inflation_time")
  thrombolyticGiven               Boolean?    @map("thrombolytic_given")
  thrombolyticAdminTime           DateTime?   @map("thrombolytic_admin_time")
  
  // PCI Procedure Phase
  cathLabActivationTime           DateTime?   @map("cath_lab_activation_time")
  cathLabArrivalTime              DateTime?   @map("cath_lab_arrival_time")
  pciProcedureStartTime           DateTime?   @map("pci_procedure_start_time")
  pciProcedureCompleteTime        DateTime?   @map("pci_procedure_complete_time")
  
  // Post-PCI Management Phase
  postPciComplications            String?     @map("post_pci_complications")
  dischargeStatus                 String?     @map("discharge_status") // STABLE, COMPLICATIONS, TRANSFERRED, etc.
  dischargeMedications            String?     @map("discharge_medications")
  followUpAppointmentDate         DateTime?   @map("follow_up_appointment_date")
  followUpAppointmentProvider     String?     @map("follow_up_appointment_provider")
  
  // Outcome Form Management
  outcomeFormCompleted            Boolean     @default(false) @map("outcome_form_completed")
  outcomeFormCompletionDate       DateTime?   @map("outcome_form_completion_date")
  outcomePercentageCompleteness   Int?        @map("outcome_percentage_completeness")
  
  // Outcomes
  successful                      Boolean?    @map("successful")
  complications                   String?     @map("complications")
  dischargeDate                   DateTime?   @map("discharge_date")
  thirtyDayReadmission            Boolean     @default(false) @map("thirty_day_readmission")
  followUpCallCompleted           Boolean     @default(false) @map("follow_up_call_completed")
  followUpCallDate                DateTime?   @map("follow_up_call_date")
  
  // Quality Metrics (calculated in minutes)
  doorToEcgMinutes                Int?        @map("door_to_ecg_minutes")
  rccActivationToDoorOutMinutes   Int?        @map("rcc_activation_to_door_out_minutes")
  doorInDoorOutMinutes            Int?        @map("door_in_door_out_minutes")
  doorToNeedleMinutes             Int?        @map("door_to_needle_minutes")
  doorToBalloonMinutes            Int?        @map("door_to_balloon_minutes")
  
  // KPI Achievement Flags
  metKpi1                         Boolean?    @map("met_kpi_1") // Door to ECG ≤10min
  metKpi2                         Boolean?    @map("met_kpi_2") // Door to Balloon ≤90min (Direct) / ≤120min (Transfer)
  metKpi2Direct                   Boolean?    @map("met_kpi_2_direct") // Door to Balloon ≤90min (Direct cases)
  metKpi2Transfer                 Boolean?    @map("met_kpi_2_transfer") // Door to Balloon ≤120min (Transfer cases)
  metKpi3                         Boolean?    @map("met_kpi_3") // Door to Needle ≤30min
  metKpi4                         Boolean?    @map("met_kpi_4") // RCC Activation ≤15min
  metKpi5                         Boolean?    @map("met_kpi_5") // Door In Door Out ≤30min
  metKpi6                         Boolean?    @map("met_kpi_6") // Primary PCI Success ≥95%
  
  // Audit Fields
  createdAt                       DateTime    @default(now()) @map("created_at")
  updatedAt                       DateTime    @updatedAt @map("updated_at")
  deletedAt                       DateTime?   @map("deleted_at")
  createdById                     String      @map("created_by_id")
  
  // Relations
  ticket                          Ticket?     @relation(fields: [ticketId], references: [id])
  patient                         Patient     @relation(fields: [patientId], references: [id])
  originHospital                  Hospital    @relation("StemiOriginHospital", fields: [originHospitalId], references: [id], onDelete: Cascade)
  destinationHospital             Hospital?   @relation("StemiDestinationHospital", fields: [destinationHospitalId], references: [id], onDelete: Cascade)
  createdBy                       User        @relation("StemiCaseCreator", fields: [createdById], references: [id])
  
  @@map("stemi_cases")
}
