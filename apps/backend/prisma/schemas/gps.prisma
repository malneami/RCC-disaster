// GPS Database Models - Consolidated
// This file contains all GPS-related database models

// GPS Tracking Log model for real-time location monitoring
model GPSTrackingLog {
  id                      String          @id @default(uuid())
  
  // Vehicle Reference
  ambulanceId             String          @map("ambulance_id")
  
  // GPS Data
  latitude                Float
  longitude               Float
  speed                   Float?          // km/h
  direction               Float?         // degrees (0-360)
  timestamp               DateTime        // When GPS data was recorded
  
  // Vehicle Status
  fuelLevel               Float?          @map("fuel_level") // Percentage if available
  engineStatus            Boolean?        @map("engine_status") // on/off
  
  // Location Details
  locationAddress         String?         @map("location_address") // Reverse geocoded
  accuracy                Float?         // GPS accuracy in meters
  
  // Audit Fields
  createdAt               DateTime        @default(now()) @map("created_at")
  
  // Relations
  ambulance               Ambulance       @relation(fields: [ambulanceId], references: [id])
  
  @@map("gps_tracking_logs")
  @@index([ambulanceId])
  @@index([timestamp])
  @@index([latitude, longitude])
  @@index([createdAt])
}

// GPS API Log model for tracking API calls (minimal logging)
model GPSApiLog {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  endpoint     String
  statusCode   Int?     @map("status_code")
  responseTime Int?     @map("response_time") // milliseconds
  error        String?
  timestamp    DateTime @default(now())
  
  @@map("gps_api_logs")
  @@index([vehicleId])
  @@index([timestamp])
  @@index([endpoint])
}

// GPS Validation Log model for tracking validation failures (minimal logging)
model GPSValidationLog {
  id              String   @id @default(uuid())
  vehicleId       String   @map("vehicle_id")
  isValid         Boolean  @map("is_valid")
  error           String?
  validationRules String   @map("validation_rules") // JSON string
  timestamp       DateTime @default(now())
  
  @@map("gps_validation_logs")
  @@index([vehicleId])
  @@index([timestamp])
  @@index([isValid])
}


