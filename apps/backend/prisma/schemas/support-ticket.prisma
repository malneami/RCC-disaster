model SupportTicket {
  id              String                @id @default(uuid())
  ticketNumber    String                @unique @map("ticket_number")
  
  description     String                
  category        SupportTicketCategory 
  status          SupportTicketStatus   @default(OPEN)
  
  // Relations
  createdBy       User                  @relation("SupportTicketCreator", fields: [createdById], references: [id])
  createdById     String                @map("created_by_id")
  
  messages        SupportMessage[]
  attachments     SupportAttachment[]
  
  // Audit Fields
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  resolvedAt      DateTime?             @map("resolved_at")
  resolvedById    String?               @map("resolved_by_id")
  resolvedBy      User?                 @relation("SupportTicketResolver", fields: [resolvedById], references: [id])
  
  @@map("support_tickets")
  @@index([ticketNumber])
  @@index([status])
  @@index([category])
  @@index([createdById])
  @@index([createdAt])
}

model SupportMessage {
  id              String                @id @default(uuid())
  ticketId        String                @map("ticket_id")
  content         String                
  senderType      MessageSenderType     @map("sender_type")
  
  // Relations
  ticket          SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender          User                  @relation("SupportMessageSender", fields: [senderId], references: [id])
  senderId        String                @map("sender_id")
  
  attachments     SupportAttachment[]
  
  // Audit Fields
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  
  @@map("support_messages")
  @@index([ticketId])
  @@index([senderId])
  @@index([senderType])
  @@index([createdAt])
}

model SupportAttachment {
  id              String                @id @default(uuid())
  ticketId        String                @map("ticket_id")
  messageId       String?               @map("message_id") 
  
  // File Details
  fileName        String                @map("file_name")
  mimeType        String                @map("mime_type")
  fileSize        Int                   @map("file_size") 
  fileData        String                @map("file_data") 
  
  // Relations
  ticket          SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message         SupportMessage?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  
  // Audit Fields
  uploadedAt      DateTime              @default(now()) @map("uploaded_at")
  uploadedBy      User                  @relation("SupportAttachmentUploader", fields: [uploadedById], references: [id])
  uploadedById    String                @map("uploaded_by_id")
  
  @@map("support_attachments")
  @@index([ticketId])
  @@index([messageId])
  @@index([uploadedById])
  @@index([uploadedAt])
}

