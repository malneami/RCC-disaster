# Database Configuration
DATABASE_URL="postgresql://rcc_admin:healthcare_secure_2024@localhost:5432/rcc_healthcare"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secure-jwt-secret-key-here"
JWT_REFRESH_SECRET="your-super-secure-refresh-secret-key-here"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Application Configuration
NODE_ENV="development"
PORT=3002
FRONTEND_URL="https://localhost:5174"

# Frontend (Vite) — keep distinct from TriagePulse defaults (5173/3001)
VITE_PORT=5174
VITE_API_BASE_URL=http://localhost:3002/api/v1
VITE_SOCKET_URL=http://localhost:3002
VITE_API_TIMEOUT=10000
VITE_HTTPS=true
VITE_HOST=true
VITE_PROXY_TARGET=http://127.0.0.1:3002

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Healthcare Compliance
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years as required by HIPAA
ENCRYPTION_KEY="your-encryption-key-for-sensitive-data"

# Email Configuration (for password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-app-password"